#!/bin/sh
# =============================================================================
# pre-push - NOTHING LEAVES THIS MACHINE UNLESS R2 HOLDS THE MATCHING CONTENT.
#
# Owner directive 2026-08-21: "make sure anything pushed always is in sync with R2."
#
# WHY A HOOK AND NOT A HABIT. CLAUDE.md section 16 records the same failure three
# times (08-18, 08-19, 08-20). Every one of them was a human being expected to
# remember a second command. Bundle names are CONTENT-HASHED, so a push from an
# earlier build can never cover a later one, and a build whose bundles were never
# uploaded installs, launches and plays - showing capsule enemies and placeholder
# buildings with NO error on screen. The only detector left is the owner's eyes,
# which is the thing section 14 exists to never rely on.
#
# THE INVARIANT, and it needs no network:
#   the R2 parity PROOF must be NEWER than the newest content it claims to prove.
# If anything under ServerData/ changed after Builds/r2-parity.log was written,
# that proof is about different bytes than the ones on disk, and it is refused.
#
# This is deliberately NOT a "did you remember?" prompt and has NO override flag -
# an override is exactly the step that got skipped on 08-20. A docs-only push
# passes on its own, because ServerData did not change and the existing proof
# still postdates it. To clear a real block, run the ONE sanctioned path:
#       powershell -File tools\r2-ship.ps1
# Never re-inline the push or the verify (section 16); call that file.
# =============================================================================

root=$(git rev-parse --show-toplevel) || exit 1

# LFS (2026-09-15): core.hooksPath REPLACES git-lfs's own pre-push hook, so LFS objects were never
# uploaded and GitHub's pre-receive rejected dev ("Try to push them with 'git lfs push --all'").
# stdin (the ref list) is consumed by the loop below, so capture it once and feed both consumers.
refs_tmp=$(mktemp) || exit 1
cat > "$refs_tmp"
lfs_ok_exit() {
    if command -v git-lfs >/dev/null 2>&1; then
        git lfs pre-push "$@" < "$refs_tmp" || { rm -f "$refs_tmp"; exit 1; }
    fi
    rm -f "$refs_tmp"; exit 0
}
server="$root/ServerData"
proof="$root/Builds/r2-parity.log"
project_version_file="$root/ProjectSettings/ProjectVersion.txt"
expected_unity="6000.4.8f1"
zero=0000000000000000000000000000000000000000
schema_changed=0

# WO-1173: api/schema.sql changing is the exact moment production can become
# stale. Inspect every commit in every outgoing ref, including a new branch.
while read local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        commits=$(git rev-list "$local_sha" --not --remotes 2>/dev/null)
    else
        commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)
    fi
    for commit in $commits; do
        if git diff-tree --no-commit-id --name-only -r "$commit" | grep -qx 'api/schema.sql'; then
            schema_changed=1
            break 2
        fi
    done
done < "$refs_tmp"

# WO-1178: a raw editor launch can rewrite this file after every wrapper's
# pre-run check. The repo cannot prevent that external process, but it can make
# the resulting downgrade impossible to push silently.
if [ ! -f "$project_version_file" ]; then
    echo "PUSH BLOCKED - UNITY_EDITOR_PIN_MISSING: $project_version_file"
    exit 1
fi
actual_unity=$(sed -n 's/^m_EditorVersion:[[:space:]]*//p' "$project_version_file" | head -1 | tr -d '\r')
if [ "$actual_unity" != "$expected_unity" ]; then
    echo ""
    echo "  PUSH BLOCKED - UNITY_EDITOR_PIN_DOWNGRADE."
    echo "  ProjectVersion.txt says '$actual_unity'; this branch requires '$expected_unity'."
    echo "  A mismatched editor forces a full Bee rebuild and can make a gate exit 0"
    echo "  before its success marker is emitted. Restore the pinned version and rerun."
    echo ""
    exit 1
fi
echo "[pre-push] Unity editor pin is $expected_unity. OK."

if [ "$schema_changed" -eq 1 ]; then
    schema_log="$root/Builds/schema-parity.log"
    mkdir -p "$root/Builds"
    node "$root/tools/schema-parity.mjs" >"$schema_log" 2>&1
    schema_exit=$?
    cat "$schema_log"
    if [ "$schema_exit" -ne 0 ] || ! grep -q '^SCHEMA_PARITY_OK ' "$schema_log"; then
        echo ""
        echo "  PUSH BLOCKED - api/schema.sql changed but SCHEMA_PARITY_OK was not proven."
        echo "  See Builds/schema-parity.log. Apply the tracked migration, then rerun."
        echo ""
        exit 1
    fi
    echo "[pre-push] SCHEMA_PARITY_OK after api/schema.sql change."
fi

# Nothing to serve -> nothing to keep in sync.
[ -d "$server" ] || lfs_ok_exit "$@"
newest_content=$(find "$server" -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -1)
[ -n "$newest_content" ] || lfs_ok_exit "$@"

fail() {
    echo ""
    echo "  PUSH BLOCKED - R2 IS NOT IN SYNC WITH THIS TREE."
    echo "  $1"
    echo ""
    echo "  Remote art has NO local fallback. Pushing content the bucket does not hold"
    echo "  ships capsule enemies and placeholder buildings with no error on screen."
    echo "  Bundle names are content-hashed: an earlier push cannot cover this build."
    echo ""
    echo "  Fix (the one sanctioned path):  powershell -File tools\r2-ship.ps1"
    echo ""
    exit 1
}

[ -f "$proof" ] || fail "No parity proof at Builds/r2-parity.log - the bucket has never been proven for this content."

# The proof log is UTF-16 from PowerShell's Tee-Object; strip NULs before matching.
if ! tr -d '\000' < "$proof" | grep -q 'R2_PARITY_OK'; then
    fail "Builds/r2-parity.log carries NO R2_PARITY_OK marker. Marker absence is a FAILURE, not an unknown."
fi

proof_time=$(find "$proof" -printf '%T@\n' 2>/dev/null | tail -1)
if [ -z "$proof_time" ]; then
    fail "Could not read the timestamp of Builds/r2-parity.log."
fi

if [ "$(printf '%s\n%s\n' "$proof_time" "$newest_content" | sort -n | tail -1)" != "$proof_time" ]; then
    newest_file=$(find "$server" -type f -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)
    fail "Content under ServerData/ is NEWER than the last parity proof.
  newest content : $newest_file
  last proof     : Builds/r2-parity.log
  The proof describes different bytes than the ones on disk."
fi

echo "[pre-push] R2 parity proof is fresh (postdates every file under ServerData/). OK."
lfs_ok_exit "$@"
