  - m_Id: 44124330363761005
    m_Localized: "\u041F\u041E\u041B\u0423\u0427\u0415\u041D\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761006
    m_Localized: "\u0413\u041E\u0422\u041E\u0412\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761007
    m_Localized: "\u0417\u0410\u041A\u0420\u042B\u0422\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761008
    m_Localized: "\u041F\u0423\u0422\u042C \u0417\u0410\u041A\u0420\u042B\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761009
    m_Localized: "\u0412\u0415\u041D\u0415\u0426"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761010
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761011
    m_Localized: "\u041F\u043E\u043A\u0430 \u043D\u0435\u0447\u0435\u0433\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C
      - \u043F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435 \u0431\u043E\u0439
      \u043D\u0430 \u0430\u0440\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761012
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u0440\u0435\u043C\u0438\u0443\u043C-\u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761013
    m_Localized: "\u041F\u0440\u0435\u043C\u0438\u0443\u043C-\u043F\u0443\u0442\u044C
      \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u0451\u0442\u0441\u044F \u0432
      \u044D\u0442\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438. \u0412\u0441\u0451
      \u0435\u0433\u043E \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043E
      \u0432\u0430\u043C - \u0432\u0430\u0441 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043F\u043E\u043F\u0440\u043E\u0441\u044F\u0442 \u0443\u0433\u0430\u0434\u044B\u0432\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0441\u043A\u0440\u044B\u0442\u043E \u0437\u0430 \u0437\u0430\u043C\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761014
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u0443\u0442\u044C
      \u043F\u043E\u0437\u0436\u0435 \u0432\u0430\u043C \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0441\u0442\u043E\u0438\u0442: \u0432\u0441\u0435 \u043F\u0440\u0435\u043C\u0438\u0443\u043C-\u043D\u0430\u0433\u0440\u0430\u0434\u044B,
      \u0434\u043E \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432\u044B \u0443\u0436\u0435
      \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C, \u0432\u044B\u0434\u0430\u044E\u0442\u0441\u044F
      \u0441\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761015
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u043D\u0435\u0442 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
      \u0441\u0435\u0437\u043E\u043D\u0430. \u041D\u043E\u0432\u044B\u0439 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430 \u043C\u0435\u0441\u044F\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761016
    m_Localized: "\u041C\u0435\u0441\u044F\u0447\u043D\u044B\u0439 \u0440\u0435\u0435\u0441\u0442\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761017
    m_Localized: "\u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0439:
      {0}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 44124330363761018
    m_Localized: "\u0423 \u0432\u0430\u0441 \u043D\u0435\u0442 \u0440\u0435\u0435\u0441\u0442\u0440\u0430.
      \u0412\u0441\u0435 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u043D\u0435\u0439
      \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u044B \u043D\u0438\u0436\u0435,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0432\u044B \u0447\u0442\u043E-\u043B\u0438\u0431\u043E
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u0435 - \u0437\u0434\u0435\u0441\u044C
      \u043D\u0435\u0442 \u0441\u043A\u0440\u044B\u0442\u044B\u0445 \u0438 \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u0445
      \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761019
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761020
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u043E. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
      \u0441\u0442\u0430\u043D\u0435\u0442 \u0432\u0430\u0448\u0438\u043C \u0437\u0430\u0432\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761021
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0435
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761022
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0432 \u0434\u0435\u043D\u044C,
      \u0432\u044B \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0442\u0435\u0440\u044F\u0435\u0442\u0435.
      \u0420\u0435\u0435\u0441\u0442\u0440 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
      \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0439
      \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442, \u043F\u043E\u043A\u0430
      \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043E
      \u043A\u0430\u0436\u0434\u043E\u0435, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0431\u044B \u044D\u0442\u043E \u043D\u0438 \u0437\u0430\u043D\u044F\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761023
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0442\u0435\u0440\u044F\u0435\u0442 \u0441\u0438\u043B\u0443,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0437\u0434\u0435\u0441\u044C \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043E\u0442\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761024
    m_Localized: "\u042D\u0442\u043E \u0431\u043E\u043D\u0443\u0441 \u043A \u0432\u0430\u0448\u0435\u0439
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E\u0439 \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E\u0439
      \u043D\u0430\u0433\u0440\u0430\u0434\u0435, \u0430 \u043D\u0435 \u0435\u0451
      \u0437\u0430\u043C\u0435\u043D\u0430. \u041F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435
      \u043E\u0434\u043D\u043E\u0439 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
      \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442 \u0434\u0440\u0443\u0433\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761025
    m_Localized: "\u041F\u041E\u041B\u0423\u0427\u0415\u041D\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761026
    m_Localized: "\u0421\u0415\u0413\u041E\u0414\u041D\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761027
    m_Localized: "\u0412\u0410\u0428\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761028
    m_Localized: "\u041F\u041E\u0417\u0416\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761029
    m_Localized: "\u0412 \u044D\u0442\u043E\u043C \u0440\u0435\u0435\u0441\u0442\u0440\u0435
      \u043F\u043E\u043A\u0430 \u043D\u0435\u0442 \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u043E\u0439
      \u043F\u0430\u043C\u044F\u0442\u043D\u043E\u0439 \u043D\u0430\u0433\u0440\u0430\u0434\u044B
      \u043C\u0435\u0441\u044F\u0446\u0430. \u0417\u0434\u0435\u0441\u044C \u043D\u0435
      \u043E\u0431\u0435\u0449\u0430\u044E\u0442 \u043D\u0438\u0447\u0435\u0433\u043E,
      \u0447\u0442\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u0432\u0430\u043C
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C."
