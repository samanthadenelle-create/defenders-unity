      - rid: 7338888477077143556
  - m_Id: 40931158179491889
    m_Localized: "\u0421\u0431\u043E\u0440\u0449\u0438\u043A\u0438 {0}/{1} \u043F\u043E\u043B\u043D\u044B"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491891
    m_Localized: "{0}% - \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491892
    m_Localized: "{0} \u0436\u0434\u0443\u0442"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491893
    m_Localized: "{0} \u043F\u0440\u043E\u0441\u0442\u0430\u0438\u0432\u0430\u044E\u0442"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491894
    m_Localized: "{0}/{1} \u043F\u0440\u043E\u0441\u0442\u0430\u0438\u0432\u0430\u044E\u0442"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491905
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
      \u2014 \u0441\u043D\u043E\u0432\u0430 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E
      \u0447\u0435\u0440\u0435\u0437 {0}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491907
    m_Localized: "\u042D\u0442\u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044C \u0435\u0449\u0451
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0441\u043B\u0435 \u0432\u0430\u0448\u0435\u0433\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
      \u0440\u0435\u0439\u0434\u0430. \u0421\u043D\u043E\u0432\u0430 \u0443\u0434\u0430\u0440\u0438\u0442\u044C
      \u043C\u043E\u0436\u043D\u043E \u0447\u0435\u0440\u0435\u0437 {0}."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491908
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u043F\u043E\u043A\u0430 \u0440\u0430\u0437\u0431\u0438\u0442.
      \u041F\u0435\u0440\u0435\u0433\u0440\u0443\u043F\u043F\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 {0}."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491909
    m_Localized: "{0}\u0447 {1}\u043C"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491910
    m_Localized: "{0}\u043C"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40945817733345286
    m_Localized: "\u041A\u043E\u0434 \u043F\u0440\u0438\u043D\u044F\u0442 \u2014
      {0} \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E \u0432 \u0432\u0430\u0448\u0435
      \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40945817737539585
    m_Localized: "{0} \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u0432"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40945817737539586
    m_Localized: "{0} \u0437\u043E\u043B\u043E\u0442\u0430"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40945817737539587
    m_Localized: "{0} \u043D\u0430\u0431\u043E\u0440"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40920301924036608
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0438\u0442\u0435 Chord. \u0417\u0430\u0449\u0438\u0442\u0438\u0442\u0435
      Spire."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301970173952
    m_Localized: "\u0411\u0435\u0440\u0435\u0433\u0438\u0442\u0435 Heart. \u0414\u0435\u0440\u0436\u0438\u0442\u0435
      \u0442\u044C\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301970173953
    m_Localized: "\u0411\u0435\u0440\u0435\u0433\u0438\u0442\u0435 Lantern. \u0414\u0435\u0440\u0436\u0438\u0442\u0435
      \u0442\u044C\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879361
    m_Localized: "\u0412 \u0441\u0442\u0430\u0440\u043E\u0439 \u0434\u043E\u043B\u0438\u043D\u0435
      \u2014 \u0441\u0442\u0430\u0440\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879362
    m_Localized: "\u0412\u043E \u0442\u044C\u043C\u0435 \u0437\u0430 \u0435\u0451
      \u043A\u0440\u0430\u0435\u043C \u2014 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0430\u044F
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u0433\u043D\u0438\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879363
    m_Localized: "\u0412\u044B \u2014 Keeper. \u041F\u0435\u0441\u043D\u044C \u0442\u0435\u043F\u0435\u0440\u044C
      \u0432\u0430\u0448\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879364
    m_Localized: "\u0421 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C
      \u0434\u043E\u043C\u043E\u0439, Keeper. Heart \u0433\u0443\u0434\u0438\u0442
      \u0434\u043B\u044F \u0432\u0430\u0441. \u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435\u0441\u044C
      \u2014 \u043F\u0435\u0441\u043D\u044C \u0441\u043A\u0430\u0436\u0435\u0442,
      \u0447\u0435\u0433\u043E \u0435\u0439 \u043D\u0443\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879365
    m_Localized: "\u042D\u0442\u043E Elarion. \u041A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C
      \u0434\u0430\u0438\u0441\u0430. \u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879366
    m_Localized: "Heart \u043E\u0442\u0434\u0430\u0451\u0442 \u0442\u043E, \u0447\u0442\u043E
      \u043C\u043E\u0436\u0435\u0442. \u0414\u0435\u0440\u0436\u0438\u0442\u0435
      \u0438\u0445 \u2014 \u043E\u043D\u0438 \u0432\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879367
    m_Localized: "Folk \u0432\u043E\u0437\u0432\u0435\u043B\u0438 \u044D\u0442\u043E
      \u0437\u0430\u0434\u043E\u043B\u0433\u043E \u0434\u043E \u0432\u0430\u0441.
      \u041A\u0430\u0436\u0434\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435 \u043F\u043E-\u0441\u0432\u043E\u0435\u043C\u0443
      \u0437\u0430\u0431\u043E\u0442\u0438\u0442\u0441\u044F \u043E Heart."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879368
    m_Localized: "\u0422\u043E, \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C
      \u043D\u0435 \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442, \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442
      \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0438. \u0422\u0440\u0430\u0442\u044C\u0442\u0435
      \u043C\u0443\u0434\u0440\u043E. \u041C\u043E\u043D\u0435\u0442\u044B \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073664
    m_Localized: "\u0422\u044C\u043C\u0430 \u043D\u0430\u0441 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0430.
      \u041F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432
      \u0432 \u0441\u043B\u043E\u0442\u044B. \u041E\u043D\u0438 \u0437\u043D\u0430\u044E\u0442,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073665
    m_Localized: "\u0414\u0443\u0445 \u0432 \u0441\u043B\u043E\u0442\u0435 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442.
      \u0414\u0443\u0445 \u0443 \u0437\u0434\u0430\u043D\u0438\u044F \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0435\u0442.
      \u041E\u0431\u0430 \u0441\u0440\u0430\u0437\u0443 \u043E\u043D\u0438 \u043D\u0435
      \u0443\u043C\u0435\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073666
    m_Localized: "\u042D\u0442\u043E \u0432\u0430\u0448\u0430 \u043C\u0430\u0433\u0438\u044F,
      \u043D\u043E \u0434\u0430\u0440 Heart. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0434\u0430\u043D\u043D\u043E\u0435. \u041E\u043D\u0430 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0441\u043C\u043E\u0436\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073667
    m_Localized: "\u041D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439, \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u043B\u043E\u0441\u0430 \u043F\u0430\u0434\u0430\u0435\u0442.
      \u0425\u043E\u043B\u043E\u0434 \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442
      \u0432\u0430\u043C \u0434\u044B\u0445\u0430\u043D\u0438\u0435. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0435\u0433\u043E \u0445\u043E\u0440\u043E\u0448\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073668
    m_Localized: "\u0412\u043E\u0434\u0440\u0443\u0437\u0438\u0442\u0435 \u0441\u0432\u0435\u0442
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u0442\u044C\u043C\u0430 \u0441\u0433\u0443\u0449\u0430\u0435\u0442\u0441\u044F
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E.
      \u0411\u0430\u0448\u043D\u0438 \u0432 \u0437\u043E\u043D\u0435 \u0431\u0443\u0434\u0443\u0442
      \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F \u0441\u043C\u0435\u043B\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073669
    m_Localized: "\u042D\u0442\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F
      \u043C\u0430\u0433\u0438\u044F. \u0422\u0440\u0430\u0442\u044C\u0442\u0435
      \u0435\u0451 \u043B\u0438\u0448\u044C \u043A\u043E\u0433\u0434\u0430 Heart
      \u0437\u043E\u0432\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073670
    m_Localized: "\u0421 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C
      \u0434\u043E\u043C\u043E\u0439, Keeper. Spire \u0445\u0440\u0430\u043D\u0438\u0442
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E \u043F\u0435\u0441\u043D\u044C
      \u0446\u0430\u0440\u0441\u0442\u0432\u0430. \u0417\u0430\u0449\u0438\u0442\u0438\u0442\u0435
      \u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073671
    m_Localized: "Hollowed \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u0438\u0437
      \u0442\u044C\u043C\u044B \u0437\u0430 \u0441\u0442\u0435\u043D\u0430\u043C\u0438.
      \u041E\u043D\u0438 \u0445\u043E\u0442\u044F\u0442 \u043F\u043E\u0433\u0430\u0441\u0438\u0442\u044C
      \u0421\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073672
    m_Localized: "\u0421\u0442\u0440\u043E\u0439\u0442\u0435 \u043E\u0431\u043E\u0440\u043E\u043D\u0443
      \u0438\u0437 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0435\u0441\u0442\u044C.
      \u0418\u0434\u0438\u0442\u0435 \u043A \u041A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439
      \u0448\u0430\u0445\u0442\u0435 \u2014 \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0431\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073673
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0422\u0440\u0430\u0442\u044C\u0442\u0435
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B \u0432 \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439,
      \u0447\u0442\u043E\u0431\u044B \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
      \u043E\u0431\u043E\u0440\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073674
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442\u0435
      \u0433\u043E\u0442\u043E\u0432\u044B, \u043D\u0430\u0447\u043D\u0438\u0442\u0435
      \u0432\u043E\u043B\u043D\u0443. \u041A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C
      \u043D\u0430\u0432\u044B\u043A\u0430, \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0442\u0432\u043E\u0440\u0438\u0442\u044C
      \u2014 \u043C\u0430\u0433\u0438\u044F \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 spire \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073675
    m_Localized: "\u0412\u0430\u0448\u0438 Wardens \u0441\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F
      \u0440\u044F\u0434\u043E\u043C. \u041A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C
      \u043E\u0434\u043D\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0437\u043D\u0430\u0447\u0438\u0442\u044C
      \u043F\u043E\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073676
    m_Localized: "Spire \u043F\u043E\u043C\u043D\u0438\u0442 \u0432\u0430\u0448\u0443
      \u0434\u043E\u0431\u0440\u043E\u0442\u0443. \u0411\u0435\u0440\u0435\u0433\u0438\u0442\u0435
      \u0435\u0433\u043E, Keeper."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368256
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u0434\u0435\u0440\u0436\u0430\u0442
      \u0441\u0438\u043B\u043E\u0432\u043E\u0439 \u0449\u0438\u0442 \u0438\u0437
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430
      Heart \u2014 \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435, \u043A\u0430\u043A
      \u043E\u043D \u043C\u0435\u0440\u0446\u0430\u0435\u0442 \u0432 \u0432\u043E\u0440\u043E\u0442\u0430\u0445.
      \u041F\u043E\u043A\u0430 \u043E\u043D \u0441\u0438\u044F\u0435\u0442, \u043E\u043D
      \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 Hollowed.
      \u041D\u043E \u043A\u0430\u0436\u0434\u044B\u0439 \u0443\u0434\u0430\u0440
      \u0438\u0441\u0442\u043E\u043D\u0447\u0430\u0435\u0442 \u0435\u0433\u043E,
      \u0430 \u0438\u0441\u0442\u043E\u043D\u0447\u0451\u043D\u043D\u044B\u0439 \u0449\u0438\u0442
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0442\u044C\u043C\u0443.
      \u0427\u0438\u043D\u0438\u0442\u0435 \u0441\u0442\u0435\u043D\u044B \u0438
      \u0432\u043E\u0440\u043E\u0442\u0430 \u2014 \u0438 \u0441\u0432\u0435\u0442
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442 \u0441\u0438\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073677
    m_Localized: "\u0421\u0432\u0435\u0442 Heart \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0441\u044F
      \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C\u0438, \u043A\u043E\u0433\u043E
      \u0437\u043D\u0430\u0435\u0442. \u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435,
      Keeper \u2014 \u043D\u043E Hollow Ones \u0431\u0443\u0434\u0443\u0442 \u0434\u0430\u0432\u0438\u0442\u044C.
      \u0427\u0438\u043D\u0438\u0442\u0435 \u0432\u043E\u0440\u043E\u0442\u0430 \u0442\u0430\u043A
      \u0436\u0435, \u043A\u0430\u043A \u0441\u0442\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073678
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u043F\u0430\u043B\u0438.
      \u041E\u043D\u0438 \u0438\u0434\u0443\u0442 \u0431\u0435\u0441\u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E.
      \u0414\u0435\u0440\u0436\u0438\u0442\u0435 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0435
      \u043A\u043E\u043B\u044C\u0446\u043E \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
      \u0449\u0438\u0442 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0442\u044C\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073679
    m_Localized: "\u0421\u0432\u0435\u0442 \u043F\u043E\u043C\u043D\u0438\u0442 \u0432\u0430\u0441.
      \u0412\u043E\u0440\u043E\u0442\u0430 \u0441\u043D\u043E\u0432\u0430 \u0434\u0435\u0440\u0436\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073680
    m_Localized: "\u041E\u043D\u0438 \u0438\u0434\u0443\u0442 \u0438\u0437 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0445
      \u043C\u0435\u0441\u0442. \u0411\u0443\u0434\u0443\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0438 \u043A\u0443\u0441\u0430\u0442\u044C
      \u0441\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073681
    m_Localized: "\u041C\u043E\u0440\u043E\u0437\u043D\u044B\u0435 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0435
      \u0443 \u0432\u043E\u0440\u043E\u0442. \u0414\u0435\u0440\u0436\u0438\u0442\u0435
      \u043E\u0433\u043D\u0438 \u0437\u0430\u0436\u0436\u0451\u043D\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073682
    m_Localized: "\u0418\u0434\u0443\u0442 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435
      \u0441 \u0443\u0433\u043B\u044F\u043C\u0438, \u0436\u0430\u0434\u043D\u044B\u0435
      \u0434\u043E \u0437\u0435\u043B\u0435\u043D\u0438. \u0414\u0435\u0440\u0436\u0438\u0442\u0435
      \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0435 \u043F\u043E\u043B\u043E\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073683
    m_Localized: "\u041E\u043D\u0438 \u0433\u043E\u0440\u044F\u0442 \u043D\u0430
      \u043C\u0430\u0440\u0448\u0435. \u041D\u0435 \u0434\u0430\u0439\u0442\u0435
      \u0438\u043C \u043A\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F \u043A\u043E\u0440\u043D\u0435\u0439
      Heart."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073684
    m_Localized: "\u041E\u0433\u043E\u043D\u044C\u043A\u0438 \u043D\u0435\u0441\u043E\u0437\u0434\u0430\u043D\u043D\u043E\u0433\u043E
      \u2014 \u0431\u044B\u0441\u0442\u0440\u044B\u0435, \u043F\u043E\u043B\u0443\u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435.
      \u0426\u0435\u043B\u044C\u0442\u0435\u0441\u044C \u0442\u043E\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073685
    m_Localized: "\u041F\u043E\u043B\u0443\u0434\u0443\u0448\u0438 \u043F\u043B\u044B\u0432\u0443\u0442.
      \u041E\u043D\u0438 \u0447\u0443\u044E\u0442 \u0437\u043E\u0432 Heart. \u041E\u0442\u0431\u0440\u043E\u0441\u044C\u0442\u0435
      \u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073686
    m_Localized: "\u041C\u043D\u043E\u0433\u043E\u0433\u043E\u043B\u043E\u0441\u0430\u044F
      \u0432\u043E\u043B\u043D\u0430. \u0427\u0438\u0442\u0430\u0439\u0442\u0435
      \u043F\u043E\u043B\u043E\u0441\u044B, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0441\u0442\u0430\u0432\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073687
    m_Localized: "\u041E\u043D\u0438 \u0438\u0434\u0443\u0442 \u0438\u0437 \u043A\u0430\u0436\u0434\u043E\u0439
      \u0442\u044C\u043C\u044B. \u0414\u043E\u0432\u0435\u0440\u044C\u0442\u0435\u0441\u044C
      \u0441\u0432\u043E\u0438\u043C Wardens."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073688
    m_Localized: "Alduin the Mournful \u0438\u0434\u0451\u0442 \u0432\u043E \u0433\u043B\u0430\u0432\u0435
      \u044D\u0442\u043E\u0439 \u0432\u043E\u043B\u043D\u044B. \u041A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u043E\u043D \u0431\u044B\u043B \u0446\u0435\u043B\u0438\u0442\u0435\u043B\u0435\u043C.
      \u0412\u0441\u0442\u0440\u0435\u0442\u044C\u0442\u0435 \u0435\u0433\u043E \u0441\u0442\u0430\u043B\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073689
    m_Localized: "\u041E\u043D \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 Withering \u043D\u0430\u0445\u043E\u0434\u0438\u0442
      \u043E\u043F\u043E\u0440\u0443. \u041E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435
      \u0435\u0433\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368257
    m_Localized: "Syndrath the Devourer \u043A\u0440\u0443\u0436\u0438\u0442 \u0432\u043E\u043A\u0440\u0443\u0433
      Heart. \u0421\u0430\u043C\u043E \u043D\u0435\u0431\u043E \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u043E\u0441\u044C
      \u043F\u0440\u043E\u0442\u0438\u0432 \u043D\u0430\u0441. \u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0432\u0432\u0435\u0440\u0445, Keeper."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368258
    m_Localized: "\u0427\u0451\u0440\u043D\u043E\u0435 \u043A\u0440\u044B\u043B\u043E
      \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0435\u0442 \u0441\u043E\u043B\u043D\u0446\u0435.
      Devourer \u043E\u0445\u043E\u0442\u0438\u0442\u0441\u044F \u0442\u0430\u043C,
      \u0433\u0434\u0435 \u0446\u0430\u0440\u0441\u0442\u0432\u043E \u0441\u043B\u0430\u0431\u0435\u0435
      \u0432\u0441\u0435\u0433\u043E \u2014 \u043D\u0435 \u0434\u0430\u0439\u0442\u0435
      \u0435\u043C\u0443 \u043D\u0430\u0439\u0442\u0438 Heart \u043D\u0435\u0433\u043E\u0442\u043E\u0432\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073690
    m_Localized: "\u041F\u0435\u0441\u043D\u044C \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F.
      \u0422\u044C\u043C\u0430 \u0443 \u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073691
    m_Localized: "\u041F\u043E\u043B\u043E\u0441\u0430 \u0434\u0440\u043E\u0433\u043D\u0443\u043B\u0430.
      Heart \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073692
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u0438\u0441\u0442\u043E\u043D\u0447\u0430\u044E\u0442\u0441\u044F.
      Heart \u0437\u043E\u0432\u0451\u0442 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073693
    m_Localized: "\u041F\u0435\u0441\u043D\u044C \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F.
      \u0417\u0430\u0449\u0438\u0449\u0430\u0439\u0442\u0435, Keeper \u2014 \u0437\u0430\u0449\u0438\u0449\u0430\u0439\u0442\u0435
      \u0441\u0435\u0439\u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073694
    m_Localized: "Heart \u0443\u0442\u0438\u0445\u0430\u0435\u0442. Folk \u0441\u043D\u043E\u0432\u0430
      \u0434\u044B\u0448\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073695
    m_Localized: "\u041E\u043D \u0441\u0442\u043E\u0438\u0442 \u0432 \u0432\u043E\u0440\u043E\u0442\u0430\u0445.
      \u0412\u0440\u0435\u043C\u044F \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442\u0441\u044F.
      \u0421\u0432\u0435\u0442 \u0442\u0443\u0441\u043A\u043D\u0435\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073696
    m_Localized: "\u041F\u0435\u0441\u043D\u044C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F.
      \u0414\u043E\u043B\u0438\u043D\u0430 \u0434\u0435\u0440\u0436\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073697
    m_Localized: "\u0421\u0432\u0435\u0442 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F.
      \u0422\u044C\u043C\u0430 \u0443 \u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073698
    m_Localized: "Spire \u0448\u0435\u0432\u0435\u043B\u0438\u0442\u0441\u044F. \u0421\u0442\u0440\u0430\u0436\u0430
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073699
    m_Localized: "\u041F\u043E\u043B\u043E\u0441\u0430 \u0434\u0440\u043E\u0433\u043D\u0443\u043B\u0430.
      Chord \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073700
    m_Localized: "\u0427\u0442\u043E-\u0442\u043E \u0434\u0430\u0432\u0438\u0442
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E.
      \u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0442\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073701
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u0438\u0441\u0442\u043E\u043D\u0447\u0430\u044E\u0442\u0441\u044F.
      Elarion \u0437\u043E\u0432\u0451\u0442 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073702
    m_Localized: "\u0414\u0432\u0435 \u043F\u043E\u043B\u043E\u0441\u044B \u0441\u0440\u0430\u0437\u0443.
      \u041D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0439\u0442\u0435
      \u0440\u0443\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073703
    m_Localized: "Chord \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F. \u0417\u0430\u0449\u0438\u0449\u0430\u0439\u0442\u0435,
      Keeper \u2014 \u0437\u0430\u0449\u0438\u0449\u0430\u0439\u0442\u0435 \u0441\u0435\u0439\u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073704
    m_Localized: "Spire \u0441\u043E\u0434\u0440\u043E\u0433\u0430\u0435\u0442\u0441\u044F.
      \u0414\u0435\u0440\u0436\u0438\u0442\u0435 \u043B\u0438\u043D\u0438\u044E \u043B\u044E\u0431\u043E\u0439
      \u0446\u0435\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073705
    m_Localized: "\u041E\u043D \u0441\u0442\u043E\u0438\u0442 \u0432 \u0432\u043E\u0440\u043E\u0442\u0430\u0445.
      \u0412\u0440\u0435\u043C\u044F \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442\u0441\u044F.
      \u0421\u0432\u0435\u0442 \u0442\u0443\u0441\u043A\u043D\u0435\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073706
    m_Localized: "Alduin the Mournful \u0438\u0434\u0451\u0442 \u043F\u043E \u043F\u043E\u043B\u043E\u0441\u0435.
      \u0412\u0441\u0442\u0440\u0435\u0442\u044C\u0442\u0435 \u0435\u0433\u043E \u0441\u0442\u0430\u043B\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073707
    m_Localized: "\u0421\u0432\u0435\u0442 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F.
      \u0414\u0435\u0440\u0435\u0432\u043D\u044F \u0441\u043D\u043E\u0432\u0430 \u0434\u044B\u0448\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073708
    m_Localized: "\u041F\u0435\u0441\u043D\u044C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F.
      Elarion \u0434\u0435\u0440\u0436\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073709
    m_Localized: "\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B \u043C\u0435\u0440\u0446\u0430\u0435\u0442.
      Heart \u043F\u0440\u0438\u043D\u044F\u043B \u043F\u0435\u0440\u0432\u044B\u0439
      \u0443\u0434\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073710
    m_Localized: "\u041B\u0438\u0441\u0442\u044C\u044F \u043F\u0430\u0434\u0430\u044E\u0442
      \u043D\u0435 \u0432 \u0441\u0435\u0437\u043E\u043D. \u041F\u0435\u0441\u043D\u044C
      \u0438\u0441\u0442\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073711
    m_Localized: "\u041A\u043E\u0440\u0430 \u0442\u0440\u0435\u0441\u043A\u0430\u0435\u0442\u0441\u044F.
      \u0414\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C, Keeper. \u0414\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073712
    m_Localized: "\u041F\u0435\u0441\u043D\u044C \u043F\u043E\u0447\u0442\u0438 \u0443\u0433\u0430\u0441\u043B\u0430.
      \u0422\u0440\u0430\u0442\u044C\u0442\u0435 \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073713
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 1081073714
    m_Localized: "\u041F\u043B\u0430\u043C\u044F \u043C\u0435\u0440\u0446\u0430\u0435\u0442.
      Lantern \u043F\u0440\u0438\u043D\u044F\u043B \u043F\u0435\u0440\u0432\u044B\u0439
      \u0443\u0434\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073715
    m_Localized: "\u041B\u0438\u0441\u0442\u044C\u044F \u043F\u0430\u0434\u0430\u044E\u0442
      \u043D\u0435 \u0432 \u0441\u0435\u0437\u043E\u043D. \u0422\u0435\u043F\u043B\u043E
      \u0438\u0441\u0442\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073716
    m_Localized: "\u041A\u043E\u0440\u0430 \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0414\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C, Guardian. \u0414\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073717
    m_Localized: "\u0421\u0432\u0435\u0442 \u043F\u043E\u0447\u0442\u0438 \u043F\u043E\u0433\u0430\u0441.
      \u0422\u0440\u0430\u0442\u044C\u0442\u0435 \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073718
    m_Localized: "\u041E\u043D\u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u044E\u0442.
      Heart \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044F.
      \u0412\u0434\u043E\u0445 \u2014 \u0438 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073719
    m_Localized: "\u0422\u044C\u043C\u0430 \u043E\u0442\u0445\u043E\u0434\u0438\u0442.
      \u041F\u043E\u0437\u0430\u0431\u043E\u0442\u044C\u0442\u0435\u0441\u044C \u043E
      \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0430\u0445. \u041F\u0435\u0441\u043D\u044C
      \u0435\u0449\u0451 \u043D\u0435 \u043A\u043E\u043D\u0447\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073720
    m_Localized: "\u041F\u043E\u043B\u043E\u0441\u044B \u0434\u0435\u0440\u0436\u0430\u0442.
      Folk \u0437\u0430\u0436\u0438\u0433\u0430\u044E\u0442 \u0441\u0432\u0435\u0447\u0443
      \u0437\u0430 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073721
    m_Localized: "Alduin \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0440\u043E\u0433\u0435 Heart. Withering \u043F\u043E\u043B\u0437\u0451\u0442
      \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073722
    m_Localized: "\u0414\u043E\u043B\u0438\u043D\u0430 \u043F\u043E\u0451\u0442.
      Folk \u043F\u043B\u0430\u0447\u0443\u0442. \u0412\u044B \u0432\u0441\u0451
      \u0435\u0449\u0451 Keeper. \u0420\u0430\u0431\u043E\u0442\u0430 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
      \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u0432\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073723
    m_Localized: "\u041D\u0438\u043A\u0442\u043E \u0434\u043E \u0432\u0430\u0441
      \u043D\u0435 \u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F \u0442\u0430\u043A
      \u0434\u043E\u043B\u0433\u043E. \u0421\u0442\u0430\u0440\u044B\u0435 Keepers
      \u043A\u0438\u0432\u043D\u0443\u043B\u0438 \u0431\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073724
    m_Localized: "\u0422\u044C\u043C\u0430 \u043E\u0442\u0445\u043E\u0434\u0438\u0442
      \u2014 \u043F\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073725
    m_Localized: "Chord \u0434\u0435\u0440\u0436\u0438\u0442. \u0421\u0442\u0440\u0430\u0436\u0430
      \u0434\u044B\u0448\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073726
    m_Localized: "Folk \u0437\u0430\u0436\u0438\u0433\u0430\u044E\u0442 \u0441\u0432\u0435\u0447\u0443
      \u0437\u0430 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073727
    m_Localized: "\u041F\u043E\u043B\u043E\u0441\u044B \u0441\u043D\u043E\u0432\u0430
      \u0442\u0438\u0445\u0438. \u041F\u043E\u0437\u0430\u0431\u043E\u0442\u044C\u0442\u0435\u0441\u044C
      \u043E Wardens."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073728
    m_Localized: "\u0412\u0434\u043E\u0445. \u041C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0432\u043E\u043B\u043D\u0430
      \u043F\u0440\u0438\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073729
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u0445\u043E\u043B\u043E\u0434\u0435\u0435\u0442.
      Elarion \u043F\u043E\u043C\u043D\u0438\u0442 \u0432\u0430\u0448\u0435 \u0438\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073730
    m_Localized: "\u041F\u0435\u0441\u043D\u044C \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      Folk \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442 \u0433\u043B\u0430\u0437\u0430.
      \u0412\u0435\u0442\u0435\u0440 \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073731
    m_Localized: "Heart \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F. \u041D\u043E
      \u0441\u0432\u044F\u0437\u044C \u2014 \u043D\u0435\u0442. \u041D\u0430\u0447\u043D\u0438\u0442\u0435
      \u0441\u043D\u043E\u0432\u0430, Keeper \u2014 \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u043E\u0442\u0432\u0435\u0442\u0430 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073732
    m_Localized: "Elarion \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F \u0442\u0443\u0434\u0430,
      \u0433\u0434\u0435 \u043D\u0443\u0436\u0435\u043D. \u0412\u044B \u0442\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073733
    m_Localized: "\u0421\u0432\u0435\u0442 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      Folk \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442 \u0433\u043B\u0430\u0437\u0430.
      \u0412\u0435\u0442\u0435\u0440 \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073734
    m_Localized: "Chord \u0434\u0440\u043E\u0433\u043D\u0443\u043B. \u041D\u043E
      \u0441\u0432\u044F\u0437\u044C \u2014 \u043D\u0435\u0442. \u041D\u0430\u0447\u043D\u0438\u0442\u0435
      \u0441\u043D\u043E\u0432\u0430, Keeper."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073735
    m_Localized: "(\u043C\u044F\u0433\u043A\u0438\u0439 \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0439
      \u0433\u0443\u043B)"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073736
    m_Localized: "(\u0442\u0451\u043F\u043B\u044B\u0439 \u0442\u044F\u0432\u043A,
      \u0441\u043B\u043E\u0432\u043D\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u0447\u0438\u043A)"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073737
    m_Localized: "(\u043D\u0438\u0437\u043A\u0438\u0439, \u043E\u0431\u0434\u0443\u043C\u0430\u043D\u043D\u044B\u0439
      \u0432\u044B\u0434\u043E\u0445)"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073738
    m_Localized: "(\u0434\u043E\u043B\u0433\u0430\u044F, \u0443\u0434\u0438\u0432\u043B\u0451\u043D\u043D\u0430\u044F
      \u043D\u043E\u0442\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073739
    m_Localized: "Sprite \u0441\u043C\u043E\u0442\u0440\u0438\u0442, \u043A\u0430\u043A
      \u0432\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u0435. \u0412\u044B
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\u0435, \u0447\u0442\u043E \u043E\u043D
      \u0432\u0438\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073740
    m_Localized: "\u041E\u043D \u0433\u0443\u0434\u0438\u0442 \u043E\u0434\u043D\u0443
      \u043D\u043E\u0442\u0443 \u2014 \u0438 \u0437\u0430\u0431\u044B\u0432\u0430\u0435\u0442
      \u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073741
    m_Localized: "\u041E\u043D \u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F \u044F\u0440\u0447\u0435,
      \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0435\u0441\u044C.
      \u0412\u044B \u0435\u0449\u0451 \u044D\u0442\u043E\u0433\u043E \u043D\u0435
      \u0437\u043D\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073742
    m_Localized: "Pup \u0441\u043D\u043E\u0432\u0430 \u0432\u0438\u0434\u0438\u0442
      \u043E\u0433\u043E\u043D\u044C \u0432\u043E \u0441\u043D\u0435. \u0425\u0432\u043E\u0441\u0442
      \u0434\u0451\u0440\u0433\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073743
    m_Localized: "\u041E\u043D \u0441\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043D\u0430 \u0442\u0451\u043F\u043B\u044B\u0445 \u043A\u0430\u043C\u043D\u044F\u0445
      \u043D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435. \u0421 \u0442\u0435\u0445
      \u043F\u043E\u0440 \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073744
    m_Localized: "\u041E\u043D \u043E\u0441\u043A\u0430\u043B\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0441\u043A\u0432\u043E\u0437\u043D\u044F\u043A. \u0421\u043A\u0432\u043E\u0437\u043D\u044F\u043A
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073745
    m_Localized: "Aldwin \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0438\u0437
      \u0441\u0430\u0434\u0430 \u0441\u043E \u043B\u044C\u0434\u043E\u043C \u043D\u0430
      \u043C\u043E\u0440\u0434\u0435. \u0412\u044B \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073746
    m_Localized: "Aldwin \u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E.
      \u041A\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
      Hollowed, \u043E\u043D \u0441\u043A\u0430\u043B\u0438\u0442 \u0437\u0443\u0431\u044B
      \u0438 \u043D\u0435 \u043E\u0442\u0432\u043E\u0434\u0438\u0442 \u0432\u0437\u0433\u043B\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073747
    m_Localized: "\u0415\u0433\u043E \u0434\u044B\u0445\u0430\u043D\u0438\u0435 \u043D\u0435
      \u0434\u0430\u0451\u0442 \u043E\u0431\u043B\u0430\u0447\u043A\u0430. \u0412\u044B
      \u0434\u0443\u043C\u0430\u0435\u0442\u0435 \u2014 \u0434\u044B\u0448\u0438\u0442
      \u043B\u0438 \u043E\u043D \u0432\u043E\u043E\u0431\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073748
    m_Localized: "Pup \u0441\u043D\u043E\u0432\u0430 \u0432\u0438\u0434\u0438\u0442
      \u043E\u0433\u043E\u043D\u044C \u0432\u043E \u0441\u043D\u0435. \u0425\u0432\u043E\u0441\u0442
      \u0434\u0451\u0440\u0433\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073749
    m_Localized: "\u0428\u0430\u0445\u0442\u0430 \u043F\u043E\u043B\u043D\u0430.
      Folk \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0441\u0432\u0435\u0447\u0443
      \u0443 \u0434\u0432\u0435\u0440\u0438 \u044D\u0442\u0438\u043C \u0443\u0442\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073750
    m_Localized: "\u0412 \u043B\u0435\u0441\u0443 \u0442\u0438\u0445\u0430\u044F
      \u0441\u0442\u0430\u0440\u0430\u044F \u043F\u0435\u0441\u043D\u044C. Heart
      \u0433\u0443\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073751
    m_Localized: "Sprite \u0441\u043C\u043E\u0442\u0440\u0438\u0442, \u043A\u0430\u043A
      \u044F \u0440\u0430\u0431\u043E\u0442\u0430\u044E. \u042F \u043D\u0435 \u0437\u043D\u0430\u044E,
      \u0447\u0442\u043E \u043E\u043D \u0432\u0438\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073752
    m_Localized: "Folk \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u0445\u043B\u0435\u0431
      \u0432 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439, \u043A\u043E\u0433\u0434\u0430
      \u043C\u0435\u043D\u044F \u043D\u0435 \u0432\u0438\u0434\u044F\u0442. \u042F
      \u043D\u0430\u0445\u043E\u0436\u0443 \u0435\u0433\u043E. \u041F\u043E\u043A\u0430
      \u043D\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073753
    m_Localized: "Aldwin \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0438\u0437
      \u0441\u0430\u0434\u0430 \u0441 \u043A\u043B\u043E\u0447\u043A\u043E\u043C
      \u043B\u044C\u0434\u0430 \u043D\u0430 \u043C\u043E\u0440\u0434\u0435. \u042F
      \u0441\u043F\u0440\u043E\u0441\u0438\u043B. \u041E\u043D \u043D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073754
    m_Localized: "\u041B\u0430\u043C\u043F\u0430 \u0411\u0430\u0448\u043D\u0438 \u0433\u043E\u0440\u0438\u0442
      \u0434\u0435\u0441\u044F\u0442\u044C \u0442\u044B\u0441\u044F\u0447 \u0443\u0442\u0440.
      \u041C\u043E\u044F \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u0435\u0451
      \u0431\u0435\u0440\u0435\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073755
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043F\u0440\u043E\u0448\u043B\u043E\u0439
      \u043D\u043E\u0447\u044C\u044E Heart \u0443\u0431\u0430\u044E\u043A\u0430\u043B
      \u043C\u0435\u043D\u044F. \u042F \u0443\u0436\u0435 \u043D\u0435 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E,
      \u0433\u0434\u0435 \u043A\u043E\u043D\u0447\u0430\u0435\u0442\u0441\u044F \u0435\u0433\u043E
      \u0433\u043E\u043B\u043E\u0441 \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073756
    m_Localized: "Sprite \u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F \u044F\u0440\u0447\u0435.
      \u0422\u043E, \u0447\u0435\u0433\u043E \u043E\u043D \u043D\u0435 \u0443\u043C\u0435\u043B
      \u0432\u0447\u0435\u0440\u0430, \u043E\u043D \u0443\u043C\u0435\u0435\u0442
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073757
    m_Localized: "\u041D\u043E\u0432\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \u0432
      \u043F\u0435\u0441\u043D\u0438. Heart \u043D\u0430\u0443\u0447\u0438\u043B
      \u0435\u0439, \u043F\u043E\u043A\u0430 \u0432\u044B \u0441\u043F\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073758
    m_Localized: "Alduin \u043F\u0430\u0434\u0430\u0435\u0442. Folk \u0431\u0443\u0434\u0443\u0442
      \u043F\u0435\u0442\u044C \u043E\u0431 \u044D\u0442\u043E\u043C \u0432\u0435\u0447\u0435\u0440\u0435
      \u0441\u0442\u043E \u043B\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073759
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F.
      Folk \u0443\u0437\u043D\u0430\u044E\u0442 \u0432\u0430\u0448\u0435 \u0438\u043C\u044F
      \u0432 \u0442\u0440\u0451\u0445 \u0434\u043E\u043B\u0438\u043D\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073760
    m_Localized: "\u041A\u043E\u043B\u043E\u043A\u043E\u043B \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439
      \u0442\u0435\u043F\u0435\u0440\u044C \u0433\u0440\u043E\u043C\u0447\u0435.
      Folk \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073761
    m_Localized: "\u0421\u0435\u043C\u044C \u0443\u0442\u0440 \u0437\u0430\u0431\u043E\u0442\u044B
      \u043E \u043F\u0435\u0441\u043D\u0438. \u0421\u0442\u0430\u0440\u044B\u0435
      Keepers \u0443\u0436\u0435 \u043D\u0430\u0437\u0432\u0430\u043B\u0438 \u0431\u044B
      \u0432\u0430\u0441 \xAB\u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043D\u0430\u0448\u0438\u0445\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073762
    m_Localized: "Elarion \u0445\u0440\u0430\u043D\u0438\u043B \u0432\u0430\u0448
      \u043E\u0447\u0430\u0433 \u0442\u0451\u043F\u043B\u044B\u043C. \u0421 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C,
      Keeper."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368259
    m_Localized: Defenders of the Realm
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368260
    m_Localized: powered by SKR
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368261
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0421\u0442\u0440\u0430\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368262
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0414\u0435\u0440\u0435\u0432\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368263
    m_Localized: "\u0412 \u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368264
    m_Localized: Thrain
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368265
    m_Localized: "\u0422\u043A\u0430\u0447 \u041C\u043E\u0440\u043E\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368266
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0437\u043D\u0430\u0442\u043E\u043A
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u0436\u0438\u043B
      \u2014 \u0435\u0433\u043E \u043F\u043E\u0441\u043E\u0445 \u0431\u0443\u0434\u0438\u0442
      \u0445\u043E\u043B\u043E\u0434 \u043F\u0435\u0441\u043D\u0435\u0439. \u0413\u0434\u0435
      \u0438\u0434\u0451\u0442 Thrain, \u0442\u044C\u043C\u0430 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442\u0441\u044F,
      \u0430 \u0438\u043D\u0435\u0439 \u043F\u043E\u043C\u043D\u0438\u0442 \u043A\u0430\u0436\u0434\u043E\u0435
      \u0438\u043C\u044F, \u0447\u0442\u043E \u0437\u0430\u043C\u043E\u0440\u043E\u0437\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368267
    m_Localized: Grom
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368268
    m_Localized: "\u041D\u043E\u0441\u0438\u0442\u0435\u043B\u044C \u0421\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368269
    m_Localized: "\u0421 \u043C\u043E\u043B\u043E\u0442\u043E\u043C \u0432 \u0440\u0443\u043A\u0435
      \u0438 \u0441\u043E\u043B\u043D\u0446\u0435\u043C \u043D\u0430 \u0449\u0438\u0442\u0435
      Grom \u043D\u0435\u0441\u0451\u0442 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u043B\u0451\u043D\u043D\u0443\u044E
      \u0441\u0442\u0430\u043B\u044C \u0432 \u043F\u0440\u043E\u043B\u043E\u043C.
      \u0413\u0434\u0435 \u043F\u0430\u0434\u0430\u0435\u0442 \u0435\u0433\u043E
      \u0441\u0432\u0435\u0442, Hollowed \u0434\u0440\u043E\u0436\u0430\u0442, \u0430
      \u0441\u0442\u0435\u043D\u044B \u0434\u0435\u0440\u0436\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368270
    m_Localized: Sylas
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368271
    m_Localized: "\u0421\u0442\u0440\u0430\u0436 \u041B\u0435\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368272
    m_Localized: "\u042D\u043B\u044C\u0444 \u0437\u0435\u043B\u0451\u043D\u044B\u0445
      \u0442\u0440\u043E\u043F, \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u044E\u0449\u0438\u0439
      \u0447\u0438\u0441\u0442\u0443\u044E \u0441\u0442\u0440\u0435\u043B\u0443 \u043F\u043E
      \u0432\u0435\u0442\u0440\u0443 \u0437\u0430\u0434\u043E\u043B\u0433\u043E \u0434\u043E
      \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u044F \u0442\u044C\u043C\u044B.
      Sylas \u0447\u0438\u0442\u0430\u0435\u0442 \u043B\u0435\u0441, \u043B\u043E\u0432\u0438\u0442
      \u0431\u044B\u0441\u0442\u0440\u044B\u0445 \u0438 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0432\u043E\u043B\u043D\u0443 \u0441\u0442\u0440\u0435\u043B\u0430 \u0437\u0430
      \u0441\u0442\u0440\u0435\u043B\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368273
    m_Localized: Elara
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368274
    m_Localized: "\u0411\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u0426\u0435\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368275
    m_Localized: "\u0421\u043E\u0441\u0443\u0434 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0441\u0432\u0435\u0442\u0430 Heart \u2014 Elara \u043B\u0435\u0447\u0438\u0442
      \u0440\u0430\u043D\u0435\u043D\u044B\u0445 \u0438 \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u0435\u0442
      \u0432\u0435\u0440\u043D\u044B\u0445 \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u043E\u0439
      \u0437\u0430\u0449\u0438\u0442\u043E\u0439. \u0422\u044C\u043C\u0430 \u043D\u0435
      \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0451\u0442 \u043C\u0438\u043B\u043E\u0441\u0442\u044C,
      \u0447\u0442\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C \u0440\u0430\u043D\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368276
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u041F\u0435\u0440\u0432\u043E\u0433\u043E
      Warden"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368277
    m_Localized: "\u0414\u0443\u0445 \u0431\u0443\u0434\u0435\u0442 \u0438\u0434\u0442\u0438
      \u043D\u0430 \u0441\u0442\u0440\u0430\u0436\u0435 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0432\u0430\u043C\u0438. \u0421\u0432\u044F\u0436\u0438\u0442\u0435\u0441\u044C
      \u0441 \u043E\u0434\u043D\u0438\u043C \u2014 \u043E\u043D \u0443\u0437\u043D\u0430\u0435\u0442
      \u0432\u0430\u0448\u0443 \u0434\u043E\u0431\u0440\u043E\u0442\u0443 \u0438
      \u0432\u0430\u0448\u0438 \u0431\u0438\u0442\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368278
    m_Localized: "\u0421\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F \u0441 \u042D\u0442\u0438\u043C
      Warden"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073763
    m_Localized: "Aether. \u0421\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0441\u0432\u0435\u0442 Heart, \u0434\u0435\u043B\u044F\u0449\u0438\u0439\u0441\u044F
      \u0441\u043D\u043E\u0432\u0430 \u0438 \u0441\u043D\u043E\u0432\u0430. \u0427\u0438\u043D\u0438\u0442
      \u0442\u043E, \u0447\u0442\u043E \u0442\u044C\u043C\u0430 \u0440\u0430\u0441\u0442\u0440\u0435\u043F\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073764
    m_Localized: "Flame. \u0421\u0442\u0430\u0440\u043E\u0435 \u0443\u043F\u0440\u044F\u043C\u0441\u0442\u0432\u043E
      \u043E\u0447\u0430\u0433\u0430. \u0416\u0436\u0451\u0442 \u0442\u043E, \u0447\u0442\u043E
      \u043F\u043E\u043B\u0437\u0451\u0442 \u0432 \u0442\u0451\u043F\u043B\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073765
    m_Localized: "Ice. \u0422\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u044B\u0439
      \u0445\u043E\u043B\u043E\u0434, \u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439
      \u0442\u044C\u043C\u0443 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0439,
      \u043F\u043E\u043A\u0430 \u043F\u0435\u0441\u043D\u044C \u043D\u0435 \u0434\u043E\u0433\u043E\u043D\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073766
    m_Localized: "Crystals. \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439
      \u0434\u0430\u0440 Heart. \u0414\u043E\u0431\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u0435\u0433\u043E \u0438\u0437\u0431\u044B\u0442\u043E\u043A
      \u043F\u0440\u043E\u0441\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u043A\u0430\u043C\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073768
    m_Localized: "Coins. \u0422\u0438\u0445\u0430\u044F \u0432\u0430\u043B\u044E\u0442\u0430,
      \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u043D\u043D\u0430\u044F \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C\u0438
      \u0438\u0437 \u0434\u043E\u043B\u0438\u043D, \u0447\u0442\u043E \u0435\u0449\u0451
      \u0441\u0442\u043E\u044F\u0442. \u0422\u0440\u0430\u0442\u044C\u0442\u0435
      \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C
      \u043D\u0435 \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073769
    m_Localized: "\u0422\u0430\u043C, \u0433\u0434\u0435 \u0441\u0430\u043C\u043E\u0446\u0432\u0435\u0442\u043D\u044B\u0439
      \u0441\u043E\u043A Heart \u043F\u0440\u043E\u0441\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043A\u0430\u043C\u0435\u043D\u044C. \u041F\u0438\u0442\u043E\u043C\u0446\u044B
      \u0437\u0434\u0435\u0441\u044C \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u044E\u0442
      \u0437\u0430 \u0436\u0438\u043B\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073770
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u044F\u044F \u043D\u0438\u0448\u0430
      \u0432 \u043A\u043E\u0440\u043D\u044F\u0445 \u043C\u0438\u0440\u043E\u0432\u043E\u0433\u043E
      \u0434\u0435\u0440\u0435\u0432\u0430. \u042D\u0445\u043E \u043E\u0442\u0434\u044B\u0445\u0430\u044E\u0442
      \u0437\u0434\u0435\u0441\u044C \u043C\u0435\u0436\u0434\u0443 \u0431\u0438\u0442\u0432\u0430\u043C\u0438
      \u2014 \u0438\u0445 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
      \u0442\u0438\u0445\u0438\u0439 \u0433\u0443\u043B \u0432 \u043A\u0430\u043C\u043D\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073771
    m_Localized: "\u0412\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u043C\u0438
      Keepers. \u0425\u0440\u0430\u043D\u0438\u0442 \u043A\u0430\u043C\u043D\u0438
      \u0441\u0442\u0440\u0430\u0436\u0438, \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0449\u0438\u0435
      \u043D\u0430 \u0432\u0430\u0448 \u0437\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073772
    m_Localized: "\u041F\u0448\u0435\u043D\u0438\u0446\u0430 \u0440\u0430\u0441\u0442\u0451\u0442,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0442\u0430\u043A
      \u0445\u043E\u0447\u0435\u0442 Heart. \u042F\u0431\u043B\u043E\u043A\u0438
      \u043D\u0430 \u0432\u043A\u0443\u0441 \u043A\u0430\u043A \u0441\u0442\u0430\u0440\u044B\u0435
      \u043B\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073773
    m_Localized: "\u041C\u043E\u043B\u043E\u0442 \u0438 \u0433\u043E\u0440\u043D.
      Folk \u0434\u0435\u043B\u0430\u044E\u0442 \u0442\u043E, \u0447\u0442\u043E
      \u043D\u0443\u0436\u043D\u043E Keeper, \u0438 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0441\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368279
    m_Localized: "\u041B\u0435\u0437\u0432\u0438\u0435 \u043B\u0435\u0441\u043E\u043F\u0438\u043B\u043A\u0438
      \u0433\u0443\u0434\u0438\u0442 \u043E \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0437\u0435\u043B\u0451\u043D\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430 Elarion \u0435\u0449\u0451 \u0449\u0430\u0434\u044F\u0442.
      \u0415\u0451 \u0434\u043E\u0441\u043A\u0438 \u043F\u043E\u0434\u043F\u0438\u0440\u0430\u044E\u0442
      \u0432\u044B\u0441\u043E\u0447\u0430\u0439\u0448\u0438\u0435 \u0441\u0442\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368280
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u0438\u043A\u0430
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043E\u0441\u0442\u044B\u0432\u0430\u0435\u0442.
      \u0417\u0434\u0435\u0441\u044C Folk \u0431\u044C\u044E\u0442 \u0441\u044B\u0440\u043E\u0435
      \u0436\u0435\u043B\u0435\u0437\u043E \u0432 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 Hollowed \u043D\u0435 \u0442\u0430\u043A
      \u043B\u0435\u0433\u043A\u043E \u043F\u0440\u043E\u043A\u0443\u0441\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073774
    m_Localized: "\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073775
    m_Localized: "\u041C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439 \u0434\u0430\u0440
      Heart. \u0414\u043E\u0431\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0442\u0430\u043C,
      \u0433\u0434\u0435 \u0435\u0433\u043E \u0438\u0437\u0431\u044B\u0442\u043E\u043A
      \u043F\u0440\u043E\u0441\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u043A\u0430\u043C\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073778
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073779
    m_Localized: "\u0422\u0438\u0445\u0430\u044F \u0432\u0430\u043B\u044E\u0442\u0430,
      \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u043D\u043D\u0430\u044F \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C\u0438
      \u0438\u0437 \u0434\u043E\u043B\u0438\u043D, \u0447\u0442\u043E \u0435\u0449\u0451
      \u0441\u0442\u043E\u044F\u0442. \u0422\u0440\u0430\u0442\u044C\u0442\u0435
      \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C
      \u043D\u0435 \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073780
    m_Localized: "\u041E\u0441\u043A\u043E\u043B\u043A\u0438 \u041F\u0443\u0441\u0442\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073781
    m_Localized: "\u041E\u0441\u043A\u043E\u043B\u043A\u0438 Withering, \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u043F\u0430\u043B \u0432\u0435\u043B\u0438\u043A\u0438\u0439
      Hollow One. \u041A\u0430\u043C\u043D\u0438 \u0441\u0442\u0440\u0430\u0436\u0438
      \u043F\u044C\u044E\u0442 \u0438\u0445 \u0438 \u043A\u0440\u0435\u043F\u043D\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073782
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073783
    m_Localized: "\u0412\u0437\u044F\u0442 \u0438\u0437 \u0441\u0442\u0430\u0440\u044B\u0445
      \u043A\u043E\u0441\u0442\u0435\u0439 \u0434\u043E\u043B\u0438\u043D\u044B.
      \u0421\u0442\u0435\u043D\u044B \u043F\u043E\u043C\u043D\u044F\u0442 \u0435\u0433\u043E
      \u0444\u043E\u0440\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073784
    m_Localized: "\u0416\u0435\u043B\u0435\u0437\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073785
    m_Localized: "\u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u043C\u0435\u0442\u0430\u043B\u043B
      \u0438\u0437 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0445 \u0436\u0438\u043B.
      Folk \u043A\u0443\u044E\u0442 \u0438\u0437 \u043D\u0435\u0433\u043E \u0441\u0442\u0435\u043D\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u044C\u043C\u0430 \u043D\u0435\u043B\u0435\u0433\u043A\u043E
      \u043F\u0440\u043E\u0439\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073786
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073787
    m_Localized: "\u0423\u043F\u0430\u0432\u0448\u0430\u044F \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0430
      \u0438\u0437 \u0437\u0435\u043B\u0451\u043D\u044B\u0445 \u043C\u0435\u0441\u0442,
      \u0447\u0442\u043E Heart \u0435\u0449\u0451 \u0445\u0440\u0430\u043D\u0438\u0442.
      \u041F\u043E\u0434\u043F\u0438\u0440\u0430\u0435\u0442 \u0432\u044B\u0441\u043E\u0447\u0430\u0439\u0448\u0438\u0435
      \u0441\u0442\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073788
    m_Localized: "\u0421\u0442\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073789
    m_Localized: "\u0412\u043E\u0437\u0432\u0435\u0434\u0438\u0442\u0435 \u043F\u0435\u0440\u0438\u043C\u0435\u0442\u0440,
      \u0447\u0442\u043E Folk \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438
      \u0432\u043E\u043A\u0440\u0443\u0433 Heart. \u041A\u0430\u043C\u0435\u043D\u044C,
      \u0436\u0435\u043B\u0435\u0437\u043E \u0438 \u0434\u0435\u0440\u0435\u0432\u043E
      \u0447\u0438\u043D\u044F\u0442 \u0435\u0433\u043E \u0432\u044B\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073790
    m_Localized: "\u0411\u0430\u0448\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073791
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u043D\u044B\u0435 \u0448\u043F\u0438\u043B\u0438
      \u043F\u0435\u0440\u0432\u044B\u0445 Keepers. \u0418\u0445 \u043A\u0430\u043C\u043D\u0438
      \u0441\u0442\u0440\u0430\u0436\u0438 \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0442
      \u043D\u0430 \u0432\u0430\u0448 \u0437\u043E\u0432 \u043F\u0440\u043E\u0442\u0438\u0432
      \u0442\u044C\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073792
    m_Localized: "\u0421\u0442\u0440\u043E\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073793
    m_Localized: "\u041A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0439
      \u0437\u0435\u043C\u043B\u0438, \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0437\u0432\u0435\u0441\u0442\u0438
      \u0448\u043F\u0438\u043B\u044C, \u0438\u043B\u0438 \u0441\u0442\u0435\u043D\u044B,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C
      \u0432\u044B\u0448\u0435. Folk \u0441\u0434\u0435\u043B\u0430\u044E\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073794
    m_Localized: "\u041A\u043D\u0438\u0433\u0430 Keeper"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073795
    m_Localized: "\u0421\u043D\u043E\u0432\u0430 \u0443\u0441\u043B\u044B\u0448\u044C\u0442\u0435
      \u0441\u0442\u0430\u0440\u0443\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E,
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435 \u043A\u043E\u043F\u0438\u044E
      \u0441\u0442\u0440\u0430\u0436\u0438 \u0438\u043B\u0438 \u043D\u0430\u0447\u043D\u0438\u0442\u0435
      \u043D\u043E\u0432\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073796
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0435 \u0423\u0440\u043E\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073797
    m_Localized: "\u041A\u0430\u043A \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0441\u0442\u0440\u0430\u0436\u0443
      \u2014 \u0442\u043E, \u0447\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043B\u0438
      \u0431\u044B \u0432\u0430\u043C \u043F\u0440\u0435\u0436\u043D\u0438\u0435
      Keepers."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073798
    m_Localized: "\u0414\u0440\u0443\u0433\u0438\u0435 \u0414\u043E\u043B\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073799
    m_Localized: "\u0421\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435 \u0441\u0442\u0440\u0430\u0436\u0443
      \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 Keepers, \u0432\u0435\u0434\u0438\u0442\u0435
      \u0441\u043F\u0438\u0441\u043E\u043A \u0438 \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C
      \u0432\u0435\u0441\u0442\u044F\u043C\u0438 \u043F\u043E \u0446\u0430\u0440\u0441\u0442\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073800
    m_Localized: "\u041F\u043E\u0447\u0442\u043E\u0432\u044B\u0439 \u042F\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073801
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u043A\u0438, \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u043D\u043D\u044B\u0435
      \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C\u0438. \u041E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435
      \u0441\u0432\u043E\u0451 \u0441\u043B\u043E\u0432\u043E \u0441 \u043C\u0435\u0442\u043A\u043E\u0439
      \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073802
    m_Localized: "\u0412\u0430\u0448 \u0417\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073803
    m_Localized: "\u0412\u0441\u0451, \u0447\u0442\u043E \u0432\u044B \u0441\u043E\u0431\u0440\u0430\u043B\u0438
      \u2014 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0439
      \u0434\u0443\u0445, \u043A\u0430\u0436\u0434\u043E\u0435 \u0432\u043E\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073804
    m_Localized: "\u0422\u044C\u043C\u0430 \u0428\u0435\u0432\u0435\u043B\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073805
    m_Localized: "\u0412\u043E\u043B\u043D\u0430 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0437\u0430 \u0441\u0442\u0435\u043D\u0430\u043C\u0438. \u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435
      \u0447\u0442\u043E \u043C\u043E\u0436\u0435\u0442\u0435 \u0438 \u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
      \u043E\u0431\u043E\u0440\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073806
    m_Localized: "\u0412\u044B\u0437\u0432\u0430\u0442\u044C \u0412\u043E\u043B\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073807
    m_Localized: "\u041D\u0435 \u0436\u0434\u0438\u0442\u0435 \u0442\u044C\u043C\u0443.
      \u0412\u0441\u0442\u0440\u0435\u0442\u044C\u0442\u0435 \u0435\u0451 \u0441\u0435\u0439\u0447\u0430\u0441,
      \u043D\u0430 \u0441\u0432\u043E\u0435\u0439 \u0441\u0442\u0440\u0430\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073808
    m_Localized: "\u0427\u0430\u0440\u043E\u0434\u0435\u0439\u0441\u043A\u0430\u044F
      \u0421\u0442\u0440\u0435\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073809
    m_Localized: "\u0412\u0430\u0448\u0430 \u043C\u0430\u0433\u0438\u044F, \u043D\u043E
      \u0434\u0430\u0440 Heart. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0434\u0430\u043D\u043D\u043E\u0435 \u2014 \u043E\u043D\u0430 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0441\u043C\u043E\u0436\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073810
    m_Localized: "\u041C\u043E\u0440\u043E\u0437\u043D\u0430\u044F \u041D\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073811
    m_Localized: "\u041D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439, \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u043B\u043E\u0441\u0430 \u043F\u0430\u0434\u0430\u0435\u0442.
      \u0425\u043E\u043B\u043E\u0434 \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442
      \u0432\u0430\u043C \u0434\u044B\u0445\u0430\u043D\u0438\u0435. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0435\u0433\u043E \u0445\u043E\u0440\u043E\u0448\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073812
    m_Localized: "\u041C\u0430\u044F\u043A \u0418\u0441\u0446\u0435\u043B\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073813
    m_Localized: "\u0412\u043E\u0434\u0440\u0443\u0437\u0438\u0442\u0435 \u0441\u0432\u0435\u0442
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u0442\u044C\u043C\u0430 \u0441\u0433\u0443\u0449\u0430\u0435\u0442\u0441\u044F
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E.
      Heart \u0438 \u0432\u0441\u0435 \u0440\u044F\u0434\u043E\u043C \u0438\u0441\u0446\u0435\u043B\u044F\u044E\u0442\u0441\u044F
      \u0432 \u043D\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073814
    m_Localized: "\u0423\u0434\u0430\u0440 \u041C\u0435\u0442\u0435\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073815
    m_Localized: "\u042D\u0442\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F
      \u043C\u0430\u0433\u0438\u044F. \u0422\u0440\u0430\u0442\u044C\u0442\u0435
      \u0435\u0451 \u043B\u0438\u0448\u044C \u043A\u043E\u0433\u0434\u0430 Heart
      \u0437\u043E\u0432\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073816
    m_Localized: "\u0423\u0434\u0430\u0440 \u041C\u0435\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073817
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0430\u044F \u0441\u0442\u0430\u043B\u044C
      \u2014 \u0431\u043B\u0438\u0437\u043A\u043E \u0438 \u0432\u0435\u0440\u043D\u043E.
      \u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442
      \u0443 Heart \u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0433\u043E\u0442\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073818
    m_Localized: "\u0423\u0434\u0430\u0440 \u0429\u0438\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073819
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0449\u0438\u0442
      \u043F\u0440\u043E\u0442\u0438\u0432 \u0432\u043E\u043B\u043D\u044B. Hollow
      Ones \u0434\u0440\u043E\u0433\u043D\u0443\u0442 \u2014 \u0438 \u0432\u044B
      \u0443\u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u043B\u0438\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073820
    m_Localized: "\u0417\u043D\u0430\u043C\u044F \u0414\u043E\u0431\u043B\u0435\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073821
    m_Localized: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435 \u0441\u0442\u0430\u0440\u044B\u0435
      \u0446\u0432\u0435\u0442\u0430. \u0426\u0435\u043B\u044B\u0439 \u0440\u044F\u0434
      \u0442\u044C\u043C\u044B \u043F\u0430\u0434\u0430\u0435\u0442 \u0442\u0430\u043C,
      \u0433\u0434\u0435 \u0441\u0442\u043E\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073822
    m_Localized: "\u041E\u0431\u0435\u0442 \u0416\u0435\u043B\u0435\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073823
    m_Localized: "\u041E\u0431\u0435\u0449\u0430\u043D\u0438\u0435, \u0434\u0430\u043D\u043D\u043E\u0435
      Heart. \u0415\u0433\u043E \u0441\u0432\u0435\u0442 \u0432\u043D\u043E\u0432\u044C
      \u0437\u0430\u043B\u0438\u0432\u0430\u0435\u0442 \u0440\u0430\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073824
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u0412\u044B\u0441\u0442\u0440\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073825
    m_Localized: "\u0427\u0438\u0441\u0442\u0430\u044F \u0441\u0442\u0440\u0435\u043B\u0430,
      \u043F\u0443\u0449\u0435\u043D\u043D\u0430\u044F \u0434\u0430\u043B\u0435\u043A\u043E.
      \u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u0442\u043E\u0438\u0442,
      \u0438 \u0442\u0435\u0442\u0438\u0432\u0430 \u0440\u0435\u0434\u043A\u043E
      \u0431\u044B\u0432\u0430\u0435\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073826
    m_Localized: "\u0421\u0442\u0440\u0435\u043B\u0430-\u0421\u0438\u043B\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073827
    m_Localized: "\u041F\u0440\u0438\u0433\u0432\u043E\u0437\u0434\u0438\u0442\u0435
      Hollow One \u043A \u0437\u0435\u043C\u043B\u0435. \u0414\u043E \u043A\u043E\u0440\u043D\u0435\u0439
      Heart \u043E\u043D \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435
      \u0434\u043E\u0439\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073828
    m_Localized: "\u0413\u043B\u0430\u0437 \u042F\u0441\u0442\u0440\u0435\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073829
    m_Localized: "\u0426\u0435\u043B\u044C\u0442\u0435\u0441\u044C \u0442\u043E\u0447\u043D\u043E
      \u0438 \u0434\u0430\u043B\u0435\u043A\u043E. \u041E\u0434\u0438\u043D \u0432\u044B\u0441\u0442\u0440\u0435\u043B
      \u043D\u0435\u0441\u0451\u0442 \u0432\u0435\u0441 \u0442\u044C\u043C\u044B,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432\u044B \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073830
    m_Localized: "\u0417\u0430\u043B\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073831
    m_Localized: "\u0412\u044B\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0432\u0441\u0435
      \u0441\u0442\u0440\u0435\u043B\u044B \u0432 \u043D\u0435\u0431\u043E \u0440\u0430\u0437\u043E\u043C.
      \u041E\u043D\u0438 \u043F\u0430\u0434\u0430\u044E\u0442 \u0442\u044F\u0436\u0451\u043B\u044B\u043C
      \u0434\u043E\u0436\u0434\u0451\u043C \u043D\u0430 \u0432\u043E\u043B\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073832
    m_Localized: "\u0422\u044F\u043D\u0438\u0442\u0435 \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A
      \u0432 \u043B\u0435\u0432\u043E\u043C \u043D\u0438\u0436\u043D\u0435\u043C
      \u0443\u0433\u043B\u0443, \u0447\u0442\u043E\u0431\u044B \u0445\u043E\u0434\u0438\u0442\u044C
      \u043F\u043E \u0434\u0435\u0440\u0435\u0432\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073833
    m_Localized: "\u041A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u043B\u044E\u0431\u043E\u0439
      \u0442\u043E\u0447\u043A\u0438 \u0437\u0435\u043C\u043B\u0438 \u2014 \u0433\u0435\u0440\u043E\u0439
      \u043F\u043E\u0439\u0434\u0451\u0442 \u0442\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073834
    m_Localized: "\u0422\u044F\u043D\u0438\u0442\u0435 \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A
      \u0434\u043B\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u2014
      \u0438\u043B\u0438 \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u0437\u0435\u043C\u043B\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0439\u0442\u0438 \u043A\u0443\u0434\u0430-\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073835
    m_Localized: "\u0426\u0430\u0440\u0441\u0442\u0432\u043E \u0437\u0430 Elarion
      \u0448\u0435\u0432\u0435\u043B\u0438\u0442\u0441\u044F. \u041F\u043E\u0441\u0435\u0442\u0438\u0442\u0435
      Wayshrine \u2014 \u0431\u043B\u0435\u0434\u043D\u044B\u0439 \u0441\u0442\u043E\u044F\u0447\u0438\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u2014 \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u043F\u043E
      \u041A\u0430\u0440\u0442\u0435 \u0426\u0430\u0440\u0441\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073836
    m_Localized: "\u041C\u0438\u043B\u043E\u0440\u0434 \u2014 \u0412\u0420\u0410\u0413\u0418!
      \u041B\u0430\u0432\u043A\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073837
    m_Localized: "\u0422\u043E\u0432\u0430\u0440\u044B \u043F\u043E\u0442\u043E\u043C,
      \u0441\u043B\u0430\u0432\u0430 \u0441\u0435\u0439\u0447\u0430\u0441! \u041A
      \u043E\u0440\u0443\u0436\u0438\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073838
    m_Localized: "\u0425\u043E\u0442\u0438\u0442\u0435 \u0437\u0430\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F?
      \u0421\u0415\u0419\u0427\u0410\u0421?! \u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435
      \u043D\u0430\u043C, \u043F\u0440\u043E\u0448\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073839
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u043D\u0430\u0441 \u043E\u0442
      \u044D\u0442\u043E\u0439 \u043E\u0440\u0430\u0432\u044B \u043D\u0435 \u0441\u043F\u0430\u0441\u0443\u0442
      \u2014 \u0432\u0430\u0448\u0430 \u043C\u0430\u0433\u0438\u044F \u0441\u043F\u0430\u0441\u0451\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073840
    m_Localized: "\u041C\u0438\u043B\u043E\u0440\u0434, \u043A\u0430\u0441\u0441\u0430
      \u0437\u0430\u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0438\u0440\u043E\u0432\u0430\u043D\u0430!
      \u041A Heart!"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073841
    m_Localized: "\u0421\u043A\u0438\u0434\u043A\u0438 \u043F\u043E\u0441\u043B\u0435
      \u0432\u043E\u043B\u043D\u044B, \u043A\u043B\u044F\u043D\u0443\u0441\u044C!
      \u0421\u0440\u0430\u0436\u0430\u0439\u0442\u0435\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368281
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u043D\u0430 SKR"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368282
    m_Localized: "\u0412\u044B \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368283
