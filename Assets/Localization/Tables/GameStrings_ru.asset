    m_Localized: "{0}x {2} \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E
      \u0441 {1}, \u0437\u0430 {3}x \u0446\u0435\u043D\u044B."
