  - m_Id: 44124330363760811
    m_Localized: "\u0413\u0435\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760812
    m_Localized: "\u0414\u041E\u0411\u0420\u041E \u041F\u041E\u0416\u0410\u041B\u041E\u0412\u0410\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760813
    m_Localized: "\u0412\u0410\u0428 \u041A\u041E\u0428\u0415\u041B\u0415\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760814
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435 \u0447\u0435\u0440\u0435\u0437
      Google, \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u043D\u0430 \u0432\u0441\u0435\u0445
      \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u0445, \u0438\u043B\u0438
      \u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u043A\u0430\u043A \u0433\u043E\u0441\u0442\u044C
      \u043D\u0430 \u044D\u0442\u043E\u043C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760815
    m_Localized: "\u0412\u0430\u0448 \u043A\u043E\u0448\u0435\u043B\u0451\u043A \u2014
      \u044D\u0442\u043E \u0432\u0430\u0448\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435.
      \u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0435\u0433\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441 (\u043E\u0434\u0438\u043D \u0440\u0430\u0437
      \u043D\u0430 \u044D\u0442\u043E\u043C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435).
      \u0413\u043E\u0441\u0442\u0435\u0432\u043E\u0439 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441
      \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0437\u0434\u0435\u0441\u044C,
      \u043F\u043E\u043A\u0430 \u0432\u044B \u043D\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760816
    m_Localized: "\u0418\u0433\u0440\u0430\u0442\u044C \u043A\u0430\u043A \u0433\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760817
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u043C \u0432\u0445\u043E\u0434
      \u0447\u0435\u0440\u0435\u0437 Google... \u0432\u044B \u0432\u0441\u0451 \u0435\u0449\u0451
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0436\u0430\u0442\u044C \xAB\u0418\u0433\u0440\u0430\u0442\u044C
      \u043A\u0430\u043A \u0433\u043E\u0441\u0442\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760818
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u043C \u0432\u0430\u0448
      \u043A\u043E\u0448\u0435\u043B\u0451\u043A... \u0432\u044B \u0432\u0441\u0451
      \u0435\u0449\u0451 \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0436\u0430\u0442\u044C
      \xAB\u0418\u0433\u0440\u0430\u0442\u044C \u043A\u0430\u043A \u0433\u043E\u0441\u0442\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760819
    m_Localized: "\u0412\u0445\u043E\u0434 \u0447\u0435\u0440\u0435\u0437 Google
      \u043D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u043B. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \xAB\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0447\u0435\u0440\u0435\u0437
      Google\xBB \u0441\u043D\u043E\u0432\u0430 \u0438\u043B\u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \xAB\u0418\u0433\u0440\u0430\u0442\u044C \u043A\u0430\u043A \u0433\u043E\u0441\u0442\u044C\xBB,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C \u0441\u0435\u0439\u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760820
    m_Localized: "\u0412\u0430\u0448 \u043A\u043E\u0448\u0435\u043B\u0451\u043A \u043D\u0435
