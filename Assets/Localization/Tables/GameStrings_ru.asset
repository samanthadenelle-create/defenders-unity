    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368284
    m_Localized: "\u041A\u0443\u0440\u0441 \u043E\u0431\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368285
    m_Localized: "\u0421\u0435\u0440\u0432\u0438\u0441\u043D\u044B\u0439 \u0441\u0431\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368286
    m_Localized: "\u0421\u0435\u0442\u0435\u0432\u043E\u0439 \u0441\u0431\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368287
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C \u0421\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368288
    m_Localized: "\u041D\u0430 \u0431\u0430\u0437\u0435 Jupiter Aggregator"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368289
    m_Localized: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0441\u0443\u043C\u043C\u0443,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043A\u0443\u0440\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368290
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u043A\u0443\u0440\u0441\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368291
    m_Localized: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043A\u043E\u0448\u0435\u043B\u0451\u043A
      \u0434\u043B\u044F \u043E\u0431\u043C\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368292
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u043A\u0430 \u0432 \u043A\u043E\u0448\u0435\u043B\u0451\u043A
      \u043D\u0430 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368293
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043A\u0443\u0440\u0441. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435
      \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368294
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u043D\u0435 \u0443\u0434\u0430\u043B\u0441\u044F.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817708179456
    m_Localized: "\u0410\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043A\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345280
    m_Localized: "\u0410\u041A\u0422\u0418\u0412\u0418\u0420\u041E\u0412\u0410\u0422\u042C
      \u041A\u041E\u0414"
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345281
    m_Localized: "\u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u043A\u043E\u0434
      \u0441 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u044F,
      \u043E\u0442 \u0430\u0432\u0442\u043E\u0440\u0430 \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0430
      \u0438\u043B\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u044B? \u0412\u0432\u0435\u0434\u0438\u0442\u0435
      \u0435\u0433\u043E \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345282
    m_Localized: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043A\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345283
    m_Localized: "\u0410\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345284
    m_Localized: "\u0420\u0435\u0433\u0438\u0441\u0442\u0440 \u0431\u0443\u043A\u0432
      \u0432 \u043A\u043E\u0434\u0435 \u043D\u0435 \u0432\u0430\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345285
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u043A\u043E\u0434..."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539584
    m_Localized: "\u041A\u043E\u0434 \u043F\u0440\u0438\u043D\u044F\u0442, \u043D\u043E
      \u0432 \u043D\u0451\u043C \u043D\u0435 \u0431\u044B\u043B\u043E \u043D\u0430\u0433\u0440\u0430\u0434\u044B
      \u0434\u043B\u044F \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539588
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u0432\u0435\u0434\u0438\u0442\u0435
      \u043A\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539589
    m_Localized: "\u042D\u0442\u043E\u0442 \u043A\u043E\u0434 \u043D\u0435 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u043D.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0438\u0435
      \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430
      \u2014 \u043A\u043E\u0434 \u043D\u0435 \u0431\u044B\u043B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539590
    m_Localized: "\u0412\u044B \u0443\u0436\u0435 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043B\u0438
      \u044D\u0442\u043E\u0442 \u043A\u043E\u0434. \u041A\u0430\u0436\u0434\u044B\u0439
      \u043A\u043E\u0434 \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0438\u0433\u0440\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539591
    m_Localized: "\u0421\u0440\u043E\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u044D\u0442\u043E\u0433\u043E \u043A\u043E\u0434\u0430 \u0438\u0441\u0442\u0451\u043A,
      \u0438 \u043E\u043D \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539592
    m_Localized: "\u0414\u043B\u044F \u044D\u0442\u043E\u0439 \u0443\u0447\u0451\u0442\u043D\u043E\u0439
      \u0437\u0430\u043F\u0438\u0441\u0438 \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442
      \u043B\u0438\u043C\u0438\u0442 \u043F\u0440\u043E\u043C\u043E\u043A\u043E\u0434\u043E\u0432,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043D\u043E\u0432\u044B\u0435 \u043A\u043E\u0434\u044B \u043D\u0435\u043B\u044C\u0437\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539593
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F
      \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u043E\u043C \u043D\u0430\u0433\u0440\u0430\u0434.
      \u041A\u043E\u0434 \u041D\u0415 \u0431\u044B\u043B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D
      \u2014 \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
      \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539594
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
      \u0432\u0430\u0448\u0443 \u0443\u0447\u0451\u0442\u043D\u0443\u044E \u0437\u0430\u043F\u0438\u0441\u044C,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043A\u043E\u0434 \u041D\u0415
      \u0431\u044B\u043B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D.
      \u0412\u043E\u0439\u0434\u0438\u0442\u0435 \u0432 \u0430\u043A\u043A\u0430\u0443\u043D\u0442
      \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539595
    m_Localized: "\u0412\u043E\u0439\u0434\u0438\u0442\u0435 \u0432 \u0430\u043A\u043A\u0430\u0443\u043D\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0435\u0439
      \u043A\u043E\u0434\u0430 \u2014 \u043D\u0430\u0433\u0440\u0430\u0434\u044B
      \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u044B \u043A \u0432\u0430\u0448\u0435\u0439
      \u0443\u0447\u0451\u0442\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539596
    m_Localized: "\u041D\u0430 \u043D\u0430\u0448\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0430 \u043E\u0448\u0438\u0431\u043A\u0430,
      \u0438 \u043A\u043E\u0434 \u041D\u0415 \u0431\u044B\u043B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D.
      \u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435 \u043F\u043E\u043F\u044B\u0442\u043A\u0443
      \u0447\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368295
    m_Localized: "\u0421\u043A\u0430\u0436\u0438\u0442\u0435 \u0427\u0435\u0441\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368296
    m_Localized: "\u0421\u043A\u0430\u0436\u0438\u0442\u0435, \u0447\u0442\u043E
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442, \u0447\u0442\u043E \u043D\u0435\u0442,
      \u0438 \u0447\u0435\u0433\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442.
      \u041C\u044B \u0447\u0438\u0442\u0430\u0435\u043C \u043A\u0430\u0436\u0434\u044B\u0439
      \u043E\u0442\u0432\u0435\u0442, \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u043E\u0434\u043D\u0430 \u2014 \u0447\u0442\u043E \u0431\u044B \u0432\u044B
      \u043D\u0438 \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368297
    m_Localized: "\u0427\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442,
      \u0430 \u0447\u0442\u043E \u043D\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368298
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0418 \u041F\u043E\u043B\u0443\u0447\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368299
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u0440\u0430\u0437:
      1000 \u0434\u0435\u0440\u0435\u0432\u0430, 1000 \u043A\u0430\u043C\u043D\u044F
      \u0438 1000 \u0436\u0435\u043B\u0435\u0437\u0430 \u2014 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368300
    m_Localized: "\u041E\u0446\u0435\u043D\u0438\u0442\u0435 \u041D\u0430\u0441 \u0412
      \u041C\u0430\u0433\u0430\u0437\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368301
    m_Localized: "\u041E\u0442\u0434\u0435\u043B\u044C\u043D\u043E, \u0438 \u0437\u0430
      \u044D\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u0435\u0442\u0441\u044F
      \u2014 \u043D\u0438 \u043E\u0434\u0438\u043D \u043C\u0430\u0433\u0430\u0437\u0438\u043D
      \u043D\u0435 \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442 \u043D\u0430\u043C,
      \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u043B\u0438 \u0432\u044B \u044D\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368302
    m_Localized: "\u041E\u0442\u0437\u044B\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368303
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u041E\u0442\u0437\u044B\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368304
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u043A\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368305
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F \u0441\u043E \u0441\u043B\u0443\u0436\u0431\u043E\u0439
      \u043E\u0442\u0437\u044B\u0432\u043E\u0432. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u043F\u043E\u0437\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368306
    m_Localized: "\u0421\u0441\u044B\u043B\u043A\u0430 \u043D\u0430 \u043C\u0430\u0433\u0430\u0437\u0438\u043D
      \u043D\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0430 \u0432
      \u044D\u0442\u043E\u0439 \u0441\u0431\u043E\u0440\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368307
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u2014 \u0432\u0430\u0448\u0438
      \u0441\u043B\u043E\u0432\u0430 \u0441 \u043D\u0430\u043C\u0438. 1000 \u0434\u0435\u0440\u0435\u0432\u0430,
      1000 \u043A\u0430\u043C\u043D\u044F \u0438 1000 \u0436\u0435\u043B\u0435\u0437\u0430
      \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u044B \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u044B
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368308
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u2014 \u0432\u0430\u0448\u0438
      \u0441\u043B\u043E\u0432\u0430 \u0441 \u043D\u0430\u043C\u0438. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u0443\u0436\u0435 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430 \u0432
      \u044D\u0442\u043E\u043C \u0446\u0430\u0440\u0441\u0442\u0432\u0435, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368309
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u2014 \u0432\u0430\u0448\u0438
      \u0441\u043B\u043E\u0432\u0430 \u0441 \u043D\u0430\u043C\u0438. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C; \u043E\u043D\u0430 \u0432\u0441\u0451
      \u0435\u0449\u0451 \u0432\u0430\u043C \u0434\u043E\u043B\u0436\u043D\u0430
      \u0438 \u043D\u0435 \u0438\u0437\u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301978562560
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0430\u043A\u043A\u0430\u0443\u043D\u0442, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u043E\u0437\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301978562561
    m_Localized: "\u0421\u0435\u0440\u0432\u0435\u0440 \u044D\u0442\u043E \u043D\u0435
      \u043F\u0440\u0438\u043D\u044F\u043B. \u041D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E \u2014
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
