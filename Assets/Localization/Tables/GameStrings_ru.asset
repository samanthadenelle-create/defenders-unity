  m_TableData:
  - m_Id: 40920301974368310
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0441\u043B\u043E\u0432, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430
      \u2014 \u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435 {Minimum} \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40920301978562563
    m_Localized: "\u0412\u0430\u0448 {Resource} \u0441\u0435\u0439\u0447\u0430\u0441
      \u043D\u0430 {AmountOver} \u0432\u044B\u0448\u0435 \u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u0438
      \u0441\u043A\u043B\u0430\u0434\u043E\u0432. \u0412\u0441\u0451 \u044D\u0442\u043E
      \u0432\u0430\u0448\u0435 \u0438 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0432\u0430\u0448\u0438\u043C; \u0441\u0431\u043E\u0440 \u0438 \u043D\u0430\u0433\u0440\u0430\u0434\u044B
      \u0432 {Resource} \u043F\u0440\u043E\u0441\u0442\u043E \u0436\u0434\u0443\u0442,
      \u043F\u043E\u043A\u0430 \u0432\u044B \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u0435
      \u0437\u0430\u043F\u0430\u0441 \u043D\u0438\u0436\u0435 \u043B\u0438\u043C\u0438\u0442\u0430."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40920301978562573
    m_Localized: "Sable \u043D\u0443\u0436\u043D\u043E {Duration}, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043A\u0430\u043C\u0435\u043D\u044C.
      \u041A\u043E\u0433\u0434\u0430 \u0440\u0430\u0431\u043E\u0442\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F,
      \u0441\u0430\u043C\u043E\u0446\u0432\u0435\u0442 \u0432\u043D\u0443\u0442\u0440\u0438
      \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0441\u043A\u0440\u044B\u0442."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40920301978562574
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u041F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0443
      - {Duration}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40920301978562579
    m_Localized: "Sable \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      {Gem}. \u0421\u0430\u043C\u043E\u0446\u0432\u0435\u0442 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D
      \u0432 \u043A\u043B\u0430\u0434\u043E\u0432\u0443\u044E."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491863
    m_Localized: "\u0412\u044B\u0431\u0440\u0430\u0442\u044C: {Language}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491867
    m_Localized: "\u041E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C {Address}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491874
    m_Localized: "\u041E\u0442\u0447\u0451\u0442\u044B \u043E\u0431 \u041E\u0431\u043E\u0440\u043E\u043D\u0435
      ({UnreadCount} \u043D\u043E\u0432\u044B\u0445)"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 40931158179491887
    m_Localized: '{Percent}%'
    m_Metadata:
