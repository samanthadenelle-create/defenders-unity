    m_Localized: "\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C
      \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
