  - m_Id: 41934581304123392
    m_Localized: "\u0412\u0430\u0448 \u0416\u0435\u043B\u0435\u0437\u043D\u044B\u0439
      \u0431\u0430\u0441\u0442\u0438\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677824
    m_Localized: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430 \u0437\u0430\u0449\u0438\u0442\u044B
      \u0433\u043E\u0440\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677825
    m_Localized: "\u0412 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0435
      \u0440\u0430\u0441\u0445\u043E\u0434\u043D\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
      \u043D\u0435 \u0442\u0440\u0430\u0442\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677826
    m_Localized: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430 \u043E\u0431\u043E\u0440\u043E\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677827
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435 \u0442\u0440\u0451\u0445
      \u043D\u0430\u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0445. \u0421\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u043C\u0443
      \u0433\u043E\u0440\u043E\u0434\u0443 \u043D\u0438\u0447\u0442\u043E \u043D\u0435
      \u0433\u0440\u043E\u0437\u0438\u0442; \u0432 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0435
      \u043D\u0435\u0442 \u043D\u0430\u0433\u0440\u0430\u0434 \u0438 \u0441\u0442\u0430\u0432\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677828
    m_Localized: "\u041E\u0431\u043E\u0440\u043E\u043D\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430.
      \u0423\u0440\u043E\u043A \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438
      \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677829
    m_Localized: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430.
      \u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u0432 \u0433\u043E\u0440\u043E\u0434
      \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0434\u0440\u0443\u0433\u0443\u044E
      \u043E\u0431\u043E\u0440\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677830
    m_Localized: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677831
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677832
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0441\u0432\u043E\u0439
      \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677833
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u043F\u0443\u0442\u0438
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435\u043C
      \u043D\u043E\u0432\u043E\u0439 \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u0431\u0430\u0448\u043D\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677834
    m_Localized: "\u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677835
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u0433\u043E\u0440\u043E\u0434. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0432\u043E\u0439\u0442\u0438 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677836
    m_Localized: "\u042D\u0442\u043E\u0442 \u0433\u043E\u0440\u043E\u0434 \u0432\u0430\u0448.
      \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D\u043D\u043E\u0435
      \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435, \u0437\u0430\u0442\u0435\u043C
      \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043D\u043E\u0432\u0443\u044E
      \u043F\u043E\u0437\u0438\u0446\u0438\u044E \u0434\u043B\u044F \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439
      \u0431\u0430\u0448\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677837
    m_Localized: "\u041F\u0440\u0438\u043F\u0430\u0441\u044B \u0437\u0430 \u0437\u0430\u0445\u0432\u0430\u0442
      \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0435\u043C\u043E\u043D\u0442. \u0415\u0441\u043B\u0438 \u0432\u0441\u0435
      \u0431\u0430\u0448\u043D\u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u044B,
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u043E\u0434\u043D\u0443,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u0435\u0451 \u043F\u043E\u0437\u0438\u0446\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677838
    m_Localized: "\u0412\u0430\u0448 \u0433\u043E\u0440\u043E\u0434 \u0443\u0446\u0435\u043B\u0435\u043B.
      \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F,
      \u0437\u0430\u0442\u0435\u043C \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      \u043D\u043E\u0432\u0443\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E \u0434\u043B\u044F
      \u0437\u0430\u0449\u0438\u0442\u043D\u043E\u0439 \u0431\u0430\u0448\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677839
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677840
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0443\u044E
      \u0437\u0430\u0449\u0438\u0442\u043D\u0443\u044E \u0431\u0430\u0448\u043D\u044E
      \u0438 \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u0435\u0451
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434 \u0438\u043B\u0438 \u0432\u043E\u0441\u0442\u043E\u043A.
      \u0412\u043E\u0439\u0434\u0438\u0442\u0435 \u0441\u043D\u043E\u0432\u0430,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0439 \u043F\u043B\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677841
    m_Localized: "\u0412\u0430\u0448 \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0439
      \u0433\u043E\u0440\u043E\u0434 \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677842
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 41934581337677843
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
