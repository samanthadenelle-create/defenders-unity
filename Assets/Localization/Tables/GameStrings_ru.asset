  - m_Id: 44124330363761046
    m_Localized: "\u041F\u041E\u0421\u0422\u0420\u041E\u0418\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761047
    m_Localized: "\u0438\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761048
    m_Localized: "\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761049
    m_Localized: "\u041F\u043E\u0442\u0440\u0430\u0442\u044C\u0442\u0435 {0}, \u0447\u0442\u043E\u0431\u044B
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043F\u043E\u0434 \u043F\u0440\u0435\u0434\u0435\u043B
      \u0432\u0430\u0448\u0435\u0433\u043E {1} - \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435
      \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D\u043E \u043D\u0430 {2}, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043F\u043E\u043A\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u0437\u0430\u0447\u0438\u0441\u043B\u044F\u0435\u0442\u0441\u044F. \u041E\u0436\u0438\u0434\u0430\u044E\u0449\u0438\u0435
      {3} \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0441\u0442\u0438
      \u0434\u043E \u044D\u0442\u043E\u0433\u043E."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 44124330363761050
    m_Localized: "\u041F\u043E\u0442\u0440\u0430\u0442\u044C\u0442\u0435 {0}, \u0447\u0442\u043E\u0431\u044B
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043F\u043E\u0434 \u043F\u0440\u0435\u0434\u0435\u043B\u044B
      \u0432\u0430\u0448\u0438\u0445 {1} - \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435
      \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D\u043E \u043D\u0430 {2}, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043F\u043E\u043A\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u0437\u0430\u0447\u0438\u0441\u043B\u044F\u0435\u0442\u0441\u044F. \u041E\u0436\u0438\u0434\u0430\u044E\u0449\u0438\u0435
      {3} \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0441\u0442\u0438
      \u0434\u043E \u044D\u0442\u043E\u0433\u043E."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 44124330363761051
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E
      - \u043A\u0430\u0436\u0434\u0430\u044F \u043E\u0436\u0438\u0434\u0430\u044E\u0449\u0430\u044F
      \u0435\u0434\u0438\u043D\u0438\u0446\u0430 \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0447\u0438\u0441\u043B\u0435\u043D\u0430,
      \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761052
    m_Localized: "\u0425\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u0431\u044B\u043B\u043E
      \u043F\u043E\u043B\u043D\u043E, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0435 \u043A\u0430\u043A
      \u0443\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u044B\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
      \u0434\u043E \u043D\u0435\u0433\u043E \u043D\u0435 \u0434\u043E\u0448\u043B\u0438
      - \u0443\u0434\u0430\u043B\u0435\u043D\u043D\u044B\u0439 \u0441\u0431\u043E\u0440
      \u043D\u0435 \u0438\u043C\u0435\u0435\u0442 \u0441\u043A\u043B\u0430\u0434\u0430
      \u0434\u043B\u044F \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u0435 \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761053
    m_Localized: "\u041A\u0430\u0442\u0430\u043B\u043E\u0433 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761054
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435, \u0447\u0442\u043E
