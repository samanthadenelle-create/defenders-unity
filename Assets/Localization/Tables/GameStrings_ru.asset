  - m_Id: 44124330363760991
    m_Localized: "\u0417\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760992
    m_Localized: "0% \u0421\u0411\u041E\u0420\u0410 - \u041A\u0410\u0416\u0414\u042B\u0419
      \u041F\u041B\u0410\u0422\u0415\u0416 \u0414\u041E\u0425\u041E\u0414\u0418\u0422
      \u0414\u041E \u041A\u041E\u0420\u041E\u041B\u0415\u0412\u0421\u0422\u0412\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760993
    m_Localized: "\u0420\u0410\u0421\u041F\u0420\u0415\u0414\u0415\u041B\u0418\u0422\u0415\u041B\u042C
      \u041D\u0410\u0413\u0420\u0410\u0414 {0}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 44124330363760994
    m_Localized: "\u0412\u0420\u0415\u041C\u042F \u0418 \u041A\u0420\u0410\u0421\u041E\u0422\u0410,
      \u041D\u041E \u041D\u0415 \u0421\u0418\u041B\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760995
    m_Localized: "\u0412\u0430\u043C \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
      \u043D\u0443\u0436\u043D\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u0442\u0440\u0430\u0442\u0438\u0442\u044C.
      \u041D\u0438\u043A\u043E\u0433\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760996
    m_Localized: "\u041F\u0443\u0442\u044C \u0441\u0435\u0437\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760997
    m_Localized: "\u0412 \u044D\u0442\u043E\u043C \u0441\u0435\u0437\u043E\u043D\u0435
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C {0} \u0434\u043D\u0435\u0439"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 44124330363760998
    m_Localized: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C {0} \u0438\u0437 {1}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 44124330363760999
    m_Localized: "{0} \u0438\u0437 {1} XP \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0443\u0440\u043E\u0432\u043D\u044F"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 44124330363761000
    m_Localized: "\u0412\u0441\u0435 \u0443\u0440\u043E\u0432\u043D\u0438 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u044B.
      {0} XP \u0437\u0430 \u0441\u0435\u0437\u043E\u043D."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 44124330363761001
    m_Localized: "\u0411\u043E\u0435\u0432\u043E\u0439 XP \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u0435\u0442\u0441\u044F
      \u0437\u0430 \u0438\u0433\u0440\u0443. \u041A\u0430\u0436\u0434\u044B\u0439
      \u0431\u043E\u0439 \u043D\u0430 \u0430\u0440\u0435\u043D\u0435 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442
      \u043D\u0430\u0433\u0440\u0430\u0434\u0443, \u043F\u043E\u0431\u0435\u0434\u0430
      \u044D\u0442\u043E \u0438\u043B\u0438 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435,
      \u0430 \u0441\u0435\u0440\u0438\u044F \u043F\u043E\u0431\u0435\u0434 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435. \u041D\u0438 \u043E\u0434\u0438\u043D
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u0451\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761002
    m_Localized: "\u0412\u0441\u0451, \u0447\u0442\u043E \u0432\u044B \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438,
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0432\u0430\u0448\u0438\u043C
      \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430. \u041F\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0438
      \u0441\u0435\u0437\u043E\u043D\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442, \u0430 \u0432\u0441\u0451
      \u043D\u0435\u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u043E\u0435 \u0432\u044B\u0434\u0430\u0451\u0442\u0441\u044F
      \u0432\u0430\u043C \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761003
    m_Localized: "\u0411\u0415\u0421\u041F\u041B\u0410\u0422\u041D\u041E"
    m_Metadata:
