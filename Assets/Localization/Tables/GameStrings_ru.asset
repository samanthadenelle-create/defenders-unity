      {0}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 43874653886263327
    m_Localized: "\u041E\u0431\u0443\u0447\u0438\u0442\u0435 \u0435\u0449\u0435 {0},
      {1} \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 43874653886263328
    m_Localized: "{0} \u0440\u0430\u0441\u043F\u0443\u0449\u0435\u043D"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 44124330326011904
    m_Localized: "\u041F\u043E\u043B\u043D\u0430\u044F \u0437\u0430\u0447\u0438\u0441\u0442\u043A\u0430
      ({0} \u0437\u0432\u0451\u0437\u0434) \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0432\u044B\u0436\u0438\u0432\u0448\u0435\u0433\u043E
      \u0431\u043E\u0439\u0446\u0430."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 44124330363760640
    m_Localized: "\u0421\u043A\u043B\u0430\u0434 \u0431\u044B\u043B \u043F\u043E\u043B\u043E\u043D
      \u2014 \u0438\u0437\u043B\u0438\u0448\u043A\u0438 \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F
      \u0432 \u0432\u0430\u0448\u0435\u043C \u0422\u0430\u0439\u043D\u0438\u043A\u0435
      \u0440\u0435\u0439\u0434\u0430, \u043F\u043E\u043A\u0430 \u0432\u044B \u043D\u0435
      \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u0435 \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760641
    m_Localized: "\u0421\u043A\u043B\u0430\u0434 \u0431\u044B\u043B \u043F\u043E\u043B\u043E\u043D,
      \u0430 \u0422\u0430\u0439\u043D\u0438\u043A \u0440\u0435\u0439\u0434\u0430
      \u0434\u043E\u0441\u0442\u0438\u0433 \u043F\u0440\u0435\u0434\u0435\u043B\u0430
      \u2014 \u0447\u0430\u0441\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0438
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760642
    m_Localized: "\u041C\u0410\u0421\u041B\u041E \u041B\u0410\u041C\u041F\u042B"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760643
    m_Localized: "\u041C\u0410\u041B\u041E \u041C\u0410\u0421\u041B\u0410 - \u041D\u0410\u0419\u0414\u0418\u0422\u0415
      \u041C\u0410\u0421\u041B\u042F\u041D\u042B\u0419 \u041A\u0410\u041C\u0415\u041D\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760644
    m_Localized: "\u041F\u043E\u043B\u043D\u0430\u044F \u0437\u0430\u0447\u0438\u0441\u0442\u043A\u0430
      ({0} \u0437\u0432\u0451\u0437\u0434) \u0434\u0435\u043B\u0430\u0435\u0442 \u044D\u0442\u0443
      \u0431\u0430\u0437\u0443 \u0432\u0430\u0448\u0435\u0439."
