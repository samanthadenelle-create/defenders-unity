      m_Items: []
  - m_Id: 41003251944435712
    m_Localized: "\u041F\u043E\u043A\u0443\u043F\u043A\u0438 \u043F\u043E\u043A\u0430
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B. \u0412\u0441\u0451
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435
      \u0437\u0434\u0435\u0441\u044C \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0432 \u0438\u0433\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 41003251969601536
    m_Localized: "\u041F\u043B\u0430\u0442\u0451\u0436\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0435\u0449\u0451 \u043D\u0435 \u0433\u043E\u0442\u043E\u0432\u0430 \u0432
      \u044D\u0442\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043D\u0435 \u0431\u044B\u043B\u0438
      \u0441\u043F\u0438\u0441\u0430\u043D\u044B. \u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435
      \u043F\u043E\u043F\u044B\u0442\u043A\u0443 \u043F\u043E\u0441\u043B\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 41003251969601537
    m_Localized: "\u0414\u043B\u044F \u043D\u0430\u0431\u043E\u0440\u043E\u0432 \u0434\u043E\u0440\u043E\u0436\u0435
      {Threshold} \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u043A\u043E\u0448\u0435\u043B\u0451\u043A, \u0447\u0442\u043E\u0431\u044B
      \u0432\u0430\u0448\u0438 \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C
      \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0435\u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
      \u0438\u0433\u0440\u044B \u0438\u043B\u0438 \u0441\u043C\u0435\u043D\u044B
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430. \u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435
      \u043A\u043E\u0448\u0435\u043B\u0451\u043A, \u0447\u0442\u043E\u0431\u044B
      \u043A\u0443\u043F\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u043D\u0430\u0431\u043E\u0440;
      \u043D\u0430\u0431\u043E\u0440\u044B \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C\u044E
      {Threshold} \u0438\u043B\u0438 \u043C\u0435\u043D\u044C\u0448\u0435 \u0443\u0436\u0435
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C
      \u0431\u0435\u0437 \u043D\u0435\u0433\u043E."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143556
  - m_Id: 41003251969601538
    m_Localized: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043A\u043E\u0448\u0435\u043B\u0451\u043A,
      \u0447\u0442\u043E\u0431\u044B \u044D\u0442\u0430 \u043F\u043E\u043A\u0443\u043F\u043A\u0430
