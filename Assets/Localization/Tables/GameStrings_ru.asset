  - m_Id: 44124330363760676
    m_Localized: "\u0411\u0430\u0448\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760677
    m_Localized: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760678
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435 \u0431\u043E\u0441\u0441\u0430,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760679
    m_Localized: "\u0417\u0410\u041F\u0415\u0427\u0410\u0422\u0410\u041D\u041E\n\u041F\u041E\u0411\u0415\u0414\u0418\u0422\u0415
      \u0411\u041E\u0421\u0421\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760680
    m_Localized: "\u0412\u042B\u0425\u041E\u0414"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760681
    m_Localized: "\u0423\u0419\u0422\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760682
    m_Localized: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760683
    m_Localized: "\xAB\u0412\u044B\u0439\u0442\u0438\xBB \u0432\u0435\u0440\u043D\u0451\u0442
      \u0432\u0430\u0441 \u0432 \u0433\u043E\u0440\u043E\u0434. \xAB\u041E\u0442\u043C\u0435\u043D\u0430\xBB
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442 \u0432\u0430\u0441 \u0432 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760684
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760685
    m_Localized: "\u041D\u0410\u0419\u0414\u0415\u041D\u041E \u0421\u041E\u041A\u0420\u041E\u0412\u0418\u0429\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760686
    m_Localized: "\u0412 \u0442\u0430\u0439\u043D\u0438\u043A\u0435:"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760687
    m_Localized: "\u041F\u0435\u0440\u0432\u043E\u0435 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u2014 \u0432\u044B \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438
      \u043D\u043E\u0432\u044B\u0439 \u0440\u0435\u0446\u0435\u043F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760688
    m_Localized: "\u0412\u0437\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760689
    m_Localized: "\u0417\u0430\u043F\u0435\u0440\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760690
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0434\u0432\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760691
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760692
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760693
    m_Localized: "\u0420\u0435\u043A\u043B\u0430\u043C\u0430 \u0438 \u0432\u0430\u0448\u0430
      \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760694
    m_Localized: "Echoes of Elarion \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443 - \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u043E\u0434\u0438\u043D \u0440\u043E\u043B\u0438\u043A, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0441\u043A\u043E\u0440\u0438\u0442\u044C \u0441\u0442\u0440\u043E\u0439\u043A\u0443
      \u0438\u043B\u0438 \u0443\u0434\u0432\u043E\u0438\u0442\u044C \u0441\u0431\u043E\u0440.
      \u0421\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0440\u0435\u043A\u043B\u0430\u043C\u0443
      \u0434\u043B\u044F \u0438\u0433\u0440\u044B \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E.\n\n\u041C\u043E\u0436\u043D\u043E
      \u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0432\u0430\u0448 \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u044B\u0439 \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443 \u0441 \u0443\u0447\u0451\u0442\u043E\u043C
      \u0432\u0430\u0448\u0438\u0445 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432?\n\n\u0415\u0441\u043B\u0438
      \u0432\u044B \u043E\u0442\u043A\u0430\u0436\u0435\u0442\u0435\u0441\u044C,
      \u0440\u0435\u043A\u043B\u0430\u043C\u0430 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C\u0441\u044F
      \u0438 \u043D\u0430\u0433\u0440\u0430\u0434\u044B \u0432\u044B \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      - \u043E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043D\u0430 \u043F\u043E\u0434 \u0432\u0430\u0441.
      \u042D\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u0432 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0432 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760695
    m_Localized: "\u0414\u0430, \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760696
    m_Localized: "\u041D\u0435\u0442, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u043E\u0431\u0449\u0443\u044E \u0440\u0435\u043A\u043B\u0430\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760697
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043C \u0432\u0430\u0448\u0435
      \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760698
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043C \u042D\u043B\u0430\u0440\u0438\u043E\u043D..."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760699
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C
      \u043E\u0431\u043B\u0438\u043A \u0432\u0430\u0448\u0435\u0433\u043E \u0433\u0435\u0440\u043E\u044F.
      \u0418\u0433\u0440\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C
      \u0437\u0434\u0435\u0441\u044C, \u0432\u043C\u0435\u0441\u0442\u043E \u0442\u043E\u0433\u043E
      \u0447\u0442\u043E\u0431\u044B \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0432\u0430\u0441 \u0431\u0435\u0437 \u043D\u0435\u0433\u043E. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435
      \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043A \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0443
      \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760700
    m_Localized: "\u0421\u043A\u0430\u0447\u0430\u0442\u044C \u0432\u0441\u0451 \u0441\u0435\u0439\u0447\u0430\u0441,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0433\u0440\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430
      \u0431\u0435\u0437 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760701
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u0440\u0430\u0437\u043C\u0435\u0440
      \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760702
    m_Localized: "\u0421\u043A\u0430\u0447\u0430\u0442\u044C \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760703
    m_Localized: "\u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760704
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0443.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451
      \u0440\u0430\u0437 \u0447\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443
      - \u0441 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
      \u0438\u0433\u0440\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043A\u0430\u043A
      \u043E\u0431\u044B\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760705
    m_Localized: "\u0412\u0441\u0451 \u0443\u0436\u0435 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043E.
