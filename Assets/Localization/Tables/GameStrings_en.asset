  - m_Id: 44124330363760693
    m_Localized: "Ads and Your Privacy"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760694
    m_Localized: "Echoes of Elarion can show optional ads - watch one to speed up a build or double a harvest. You never have to watch one to play.\n\nMay we use your advertising ID to show ads matched to your interests?\n\nIf you say no, you will still see ads and still get the rewards - they just will not be matched to you. You can change this any time in Settings."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760695
    m_Localized: "Yes, personalise ads"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760696
    m_Localized: "No, keep them generic"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760697
    m_Localized: "Loading your realm..."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760698
    m_Localized: "Loading Elarion..."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760699
    m_Localized: "Could not download your hero's artwork. The game has stopped here rather than dropping you in without it. Check your internet connection and tap Retry."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760700
    m_Localized: "Download everything now so the game works without a connection?"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760701
    m_Localized: "Checking download size..."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760702
    m_Localized: "Download Now"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760703
    m_Localized: "Not Now"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760704
    m_Localized: "We could not check the download right now. Please try again in a moment - the game still works normally with a connection."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760705
    m_Localized: "Everything is already downloaded. This game will work without a connection."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760706
    m_Localized: "Size: {0} MB\n{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760707
    m_Localized: "You need Wi-Fi for this one-time download. After it finishes the game opens without a connection."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760708
    m_Localized: "Downloading content. Keep this screen open."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760709
    m_Localized: "About {0} on a fast connection, up to {1} on a slow one."
