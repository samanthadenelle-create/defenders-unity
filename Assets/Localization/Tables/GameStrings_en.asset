  - m_Id: 40945817708179456
    m_Localized: Redeem a Code
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345280
    m_Localized: REDEEM A CODE
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345281
    m_Localized: Have a code from an event, a creator or the team? Enter it here.
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345282
    m_Localized: Enter your code
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345283
    m_Localized: Redeem
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345284
    m_Localized: Codes are not case sensitive.
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345285
    m_Localized: Checking your code...
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345286
    m_Localized: Code accepted - {0} added to your realm.
    m_Metadata:
      m_Items:
      - rid: 7338888474672496640
  - m_Id: 40945817737539584
    m_Localized: Code accepted, but it carried no reward to add.
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539585
    m_Localized: '{0} Crystals'
    m_Metadata:
      m_Items:
      - rid: 7338888474672496640
  - m_Id: 40945817737539586
    m_Localized: '{0} Gold'
    m_Metadata:
      m_Items:
