  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: GameStrings_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: a280628737193b24f9e44f409150a145, type: 2}
  m_Metadata:
    m_Items:
    - rid: 7338888477077143555
  m_TableData:
  - m_Id: 40920301974368310
    m_Localized: "Quelques mots de plus, s'il vous pla\xEEt \u2014 au moins {Minimum}
      caract\xE8res."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40920301978562563
    m_Localized: "Votre {Resource} est maintenant de {AmountOver} au-dessus de ce
      que vos r\xE9serves peuvent contenir. Tout vous appartient et reste \xE0 vous
      ; les r\xE9coltes et r\xE9compenses en {Resource} se mettent simplement en
      pause jusqu'\xE0 ce que vous redescendiez en dessous."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40920301978562573
    m_Localized: "Sable a besoin de {Duration} pour polir la pierre. Quand le travail
      est termin\xE9, la gemme \xE0 l'int\xE9rieur sera r\xE9v\xE9l\xE9e."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40920301978562574
    m_Localized: Commencer le Poli - {Duration}
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40920301978562579
    m_Localized: "Sable r\xE9v\xE8le une {Gem}. Elle a \xE9t\xE9 ajout\xE9e \xE0
      votre garde-manger."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491863
    m_Localized: 'Choisir : {Language}'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491867
    m_Localized: "D\xE9connecter {Address}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491874
    m_Localized: "Rapports de D\xE9fense ({UnreadCount} nouveaux)"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491887
    m_Localized: '{Percent}%'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491889
    m_Localized: Collecteurs {0}/{1} pleins
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491891
    m_Localized: '{0}% - toucher'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491892
    m_Localized: '{0} en attente'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491893
    m_Localized: '{0} inactifs'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491894
    m_Localized: '{0}/{1} inactifs'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491905
    m_Localized: "R\xE9cup\xE9ration \u2014 raidable dans {0}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491907
    m_Localized: "Ce camp se remet encore de votre dernier raid. Vous pourrez le
      frapper \xE0 nouveau dans {0}."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491908
    m_Localized: "Le camp est bris\xE9 pour l'instant. Il se regroupe dans {0}."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491909
    m_Localized: '{0}h {1}m'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40931158179491910
    m_Localized: '{0}m'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40945817733345286
    m_Localized: "Code accept\xE9 \u2014 {0} ajout\xE9 \xE0 votre royaume."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40945817737539585
    m_Localized: '{0} cristaux'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40945817737539586
    m_Localized: "{0} pi\xE8ces d'or"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40945817737539587
    m_Localized: '{0} pack'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 40920301924036608
    m_Localized: "Tenez le Chord. D\xE9fendez le Spire."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301970173952
    m_Localized: "Veillez sur le Heart. Contenez les t\xE9n\xE8bres."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301970173953
    m_Localized: "Veillez sur le Lantern. Contenez les t\xE9n\xE8bres."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879361
    m_Localized: "Dans une vieille vall\xE9e, un vieil arbre."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879362
    m_Localized: "Dans le noir au-del\xE0, une lente pourriture froide."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879363
    m_Localized: "Vous \xEAtes le Keeper. Le chant est \xE0 vous, d\xE9sormais."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879364
    m_Localized: "Bienvenue chez vous, Keeper. Le Heart vibre pour vous. Marchez
      un peu \u2014 le chant vous dira ce dont il a besoin."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879365
    m_Localized: Voici Elarion. Touchez le dais. Le cristal se souviendra de vous.
    m_Metadata:
      m_Items: []
  - m_Id: 1076879366
    m_Localized: "Le Heart donne ce qu'il peut \xE9pargner. Gardez-les \u2014 vous
      en aurez besoin."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879367
    m_Localized: "Les Folk ont b\xE2ti ceci bien avant vous. Chacun soigne le Heart
      \xE0 sa fa\xE7on."
    m_Metadata:
      m_Items: []
  - m_Id: 1076879368
    m_Localized: "Ce que vous ne pouvez pas faire pousser ici, les voyageurs l'apportent.
      D\xE9pensez avec sagesse. Les pi\xE8ces se gagnent lentement."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073664
    m_Localized: "Les t\xE9n\xE8bres nous ont remarqu\xE9s. Placez vos compagnons
      dans les emplacements. Ils sauront quoi faire."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073665
    m_Localized: "Un esprit \xE0 un emplacement d\xE9fend. Un esprit \xE0 un b\xE2timent
      soigne. Ils ne peuvent pas faire les deux \xE0 la fois."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073666
    m_Localized: "C'est votre magie, mais c'est le don du Heart. Utilisez ce qui
      est donn\xE9. Elle revient quand elle peut."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073667
    m_Localized: "Pour quand une voie c\xE8de. Le froid vous ach\xE8te un souffle.
      Employez-le bien."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073668
    m_Localized: "Plantez la lumi\xE8re l\xE0 o\xF9 les t\xE9n\xE8bres s'\xE9paississent
      le plus. Les tours \xE0 port\xE9e combattront plus vaillamment."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073669
    m_Localized: "Voici la magie profonde. Ne la d\xE9pensez que lorsque le Heart
      l'appelle."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073670
    m_Localized: "Bienvenue chez vous, Keeper. Le spire retient le dernier chant
      du royaume. Prot\xE9gez-le."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073671
    m_Localized: "Les Hollowed viennent du noir au-del\xE0 des murs. Ils veulent
      \xE9teindre la Lumi\xE8re."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073672
    m_Localized: "B\xE2tissez vos d\xE9fenses avec ce que vous avez. Allez \xE0 la
      Mine de Cristal \u2014 touchez pour collecter."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073673
    m_Localized: "Bien. D\xE9pensez des cristaux \xE0 l'Atelier pour am\xE9liorer
      vos d\xE9fenses."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073674
    m_Localized: "Quand vous \xEAtes pr\xEAt, lancez une vague. Touchez une comp\xE9tence
      pour lancer \u2014 votre magie revient quand le spire le permet."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073675
    m_Localized: "Vos Wardens combattent \xE0 vos c\xF4t\xE9s. Touchez-en un pour
      lui assigner un poste."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073676
    m_Localized: "Le spire se souvient de votre bont\xE9. Veillez bien sur lui, Keeper."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368256
    m_Localized: "Les murs retiennent un champ de force fait de la propre lumi\xE8re
      du Heart \u2014 voyez-le miroiter dans les portes. Il repousse les Hollowed
      tant qu'il brille. Mais chaque coup l'affine, et un champ affin\xE9 laisse
      passer les t\xE9n\xE8bres. Gardez murs et portes r\xE9par\xE9s, et la lumi\xE8re
      garde sa force."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073677
    m_Localized: "La lumi\xE8re du Heart s'\xE9carte pour ceux qu'il conna\xEEt.
      Passez, Keeper \u2014 mais les Hollow Ones s'y presseront. R\xE9parez la porte
      comme vous r\xE9parez les murs."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073678
    m_Localized: "La porte est tomb\xE9e. Ils passent sans entrave. Tenez l'anneau
      int\xE9rieur et r\xE9parez le champ avant la prochaine obscurit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073679
    m_Localized: "La lumi\xE8re se souvient de vous. La porte tient \xE0 nouveau."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073680
    m_Localized: Ils viennent des lieux froids. Ils avanceront lentement, et mordront
      fort.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073681
    m_Localized: "Les marqu\xE9s de givre sont aux portes. Gardez vos feux allum\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073682
    m_Localized: "Les li\xE9s aux braises viennent, avides de ce qui est vert. Tenez
      les voies de l'est."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073683
    m_Localized: "Ils br\xFBlent en marchant. Ne les laissez pas toucher les racines
      du Heart."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073684
    m_Localized: "Des feux follets de l'informe \u2014 rapides, \xE0 demi pr\xE9sents.
      Visez juste."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073685
    m_Localized: "Les demi-\xE2mes d\xE9rivent. Elles sentent l'appel du Heart. Repoussez-les."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073686
    m_Localized: "Une mar\xE9e aux multiples langues. Lisez les voies avant de placer."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073687
    m_Localized: "Ils viennent de chaque obscurit\xE9. Faites confiance \xE0 vos
      Wardens."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073688
    m_Localized: "Alduin the Mournful marche en t\xEAte de cette mar\xE9e. Il fut
      gu\xE9risseur, autrefois. Accueillez-le avec l'acier."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073689
    m_Localized: Il revient quand le Withering trouve prise. Renvoyez-le.
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368257
    m_Localized: "Syndrath the Devourer tourne autour du Heart. Le ciel m\xEAme s'est
      retourn\xE9 contre nous. Gardez les yeux lev\xE9s, Keeper."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368258
    m_Localized: "Une aile noire traverse le soleil. Le Devourer chasse l\xE0 o\xF9
      le royaume est le plus faible \u2014 ne le laissez pas trouver le Heart d\xE9muni."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073690
    m_Localized: "Le chant change. Les t\xE9n\xE8bres sont aux portes."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073691
    m_Localized: Une voie vacille. Le Heart l'a senti avant vous.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073692
    m_Localized: Les murs s'amincissent. Le Heart vous appelle.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073693
    m_Localized: "Le chant se brise. D\xE9fendez, Keeper \u2014 d\xE9fendez maintenant."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073694
    m_Localized: "Le Heart s'apaise. Les folk respirent \xE0 nouveau."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073695
    m_Localized: "Il se tient dans la porte. Le temps ralentit. La lumi\xE8re s'att\xE9nue."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073696
    m_Localized: "Le chant s'\xE9l\xE8ve. La vall\xE9e tient."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073697
    m_Localized: "La lumi\xE8re change. Les t\xE9n\xE8bres sont aux portes."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073698
    m_Localized: "Le spire s'\xE9veille. La veille commence."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073699
    m_Localized: Une voie vacille. Le chord l'a senti avant vous.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073700
    m_Localized: Quelque chose pousse plus fort que le reste. Regardez-y.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073701
    m_Localized: Les murs s'amincissent. Elarion vous appelle.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073702
    m_Localized: "Deux voies \xE0 la fois. Ne cessez pas de bouger."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073703
    m_Localized: "Le chord se brise. D\xE9fendez, Keeper \u2014 d\xE9fendez maintenant."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073704
    m_Localized: "Le spire fr\xE9mit. Tenez la ligne \xE0 tout prix."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073705
    m_Localized: "Il se tient dans la porte. Le temps ralentit. La lumi\xE8re s'att\xE9nue."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073706
    m_Localized: Alduin the Mournful marche dans la voie. Accueillez-le avec l'acier.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073707
    m_Localized: "La lumi\xE8re revient. Le village respire \xE0 nouveau."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073708
    m_Localized: "Le chant s'\xE9l\xE8ve. Elarion tient."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073709
    m_Localized: "Le cristal vacille. Le Heart a re\xE7u son premier coup."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073710
    m_Localized: Des feuilles tombent hors saison. Le chant s'est aminci.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073711
    m_Localized: "L'\xE9corce se fend. Tenez, Keeper. Tenez."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073712
    m_Localized: "Le chant est presque \xE9teint. D\xE9pensez tout."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073713
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 1081073714
    m_Localized: "La flamme vacille. Le Lantern a re\xE7u son premier coup."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073715
    m_Localized: Des feuilles tombent hors saison. La chaleur s'est amincie.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073716
    m_Localized: "L'\xE9corce se fend. Tenez, Guardian. Tenez."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073717
    m_Localized: "La lumi\xE8re est presque \xE9teinte. D\xE9pensez tout."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073718
    m_Localized: Ils reculent. Le Heart se stabilise. Un souffle, puis la suivante.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073719
    m_Localized: "Les t\xE9n\xE8bres se retirent. Soignez vos compagnons. Le chant
      n'est pas encore fini."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073720
    m_Localized: Les voies tiennent. Les folk allument une chandelle pour vous.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073721
    m_Localized: Alduin se brise au seuil du Heart. Le Withering rampe vers son antre.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073722
    m_Localized: "La vall\xE9e chante. Les folk pleurent. Vous \xEAtes toujours le
      Keeper. Le travail recommence demain."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073723
    m_Localized: "Nul avant vous n'a tenu si longtemps. Les anciens Keepers auraient
      hoch\xE9 la t\xEAte."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073724
    m_Localized: "Les t\xE9n\xE8bres se retirent \u2014 pour l'instant."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073725
    m_Localized: Le chord tient. La veille respire.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073726
    m_Localized: Les Folk allument une chandelle pour vous.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073727
    m_Localized: "Les voies sont \xE0 nouveau calmes. Soignez vos Wardens."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073728
    m_Localized: "Un souffle. Un instant. La prochaine mar\xE9e viendra."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073729
    m_Localized: "Le vent se rafra\xEEchit. Elarion se souvient de votre nom."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073730
    m_Localized: "Le chant s'arr\xEAte. Les folk l\xE8vent les yeux. Le vent para\xEEt
      froid pour la premi\xE8re fois."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073731
    m_Localized: "Le Heart se brise. Mais le lien, non. Recommencez, Keeper \u2014
      il n'y a pas d'autre r\xE9ponse."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073732
    m_Localized: "Elarion reviendra l\xE0 o\xF9 on en a besoin. Vous aussi."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073733
    m_Localized: "La lumi\xE8re s'arr\xEAte. Les folk l\xE8vent les yeux. Le vent
      para\xEEt froid pour la premi\xE8re fois."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073734
    m_Localized: Le chord vacille. Mais le lien, non. Recommencez, Keeper.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073735
    m_Localized: (un doux bourdonnement musical)
    m_Metadata:
      m_Items: []
  - m_Id: 1081073736
    m_Localized: (un jappement chaud, comme une petite cloche)
    m_Metadata:
      m_Items: []
  - m_Id: 1081073737
    m_Localized: "(un souffle bas, r\xE9fl\xE9chi)"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073738
    m_Localized: (une longue note surprise)
    m_Metadata:
      m_Items: []
  - m_Id: 1081073739
    m_Localized: Le Sprite vous observe pendant que vous travaillez. Vous ignorez
      ce qu'il voit.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073740
    m_Localized: Il bourdonne une seule note, puis l'oublie.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073741
    m_Localized: Il brille davantage quand vous souriez. Vous ne le saviez pas encore.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073742
    m_Localized: "Le Pup r\xEAve encore de feu. Sa queueue tressaille."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073743
    m_Localized: "Il s'est roul\xE9 sur les pierres chaudes au coucher du soleil.
      Il n'a pas boug\xE9 depuis."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073744
    m_Localized: "Il a montr\xE9 les dents \xE0 un courant d'air. Le courant d'air
      a recul\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073745
    m_Localized: "Aldwin est revenu du verger avec de la glace sur le museau. Vous
      n'avez pas demand\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073746
    m_Localized: "Aldwin avance sans bruit. Quand les Hollowed viennent, il montre
      les dents et ne d\xE9tourne pas le regard."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073747
    m_Localized: Son souffle ne fait pas de nuage. Vous vous demandez s'il respire
      vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073748
    m_Localized: "Le Pup r\xEAve encore de feu. Sa queueue tressaille."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073749
    m_Localized: "La Mine est pleine. Les Folk ont laiss\xE9 une chandelle pr\xE8s
      de la porte ce matin."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073750
    m_Localized: Il y a un chant dans le bois, faible et ancien. Le Heart bourdonne.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073751
    m_Localized: Le Sprite m'observe pendant que je travaille. J'ignore ce qu'il
      voit.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073752
    m_Localized: Les Folk laissent du pain dans l'atelier quand ils ne me voient
      pas. Je le trouve. Je ne les remercie pas encore.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073753
    m_Localized: "Aldwin est revenu du verger avec un \xE9clat de glace sur le museau.
      J'ai demand\xE9. Il n'a rien dit."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073754
    m_Localized: "La lampe de la Tour br\xFBle depuis dix mille matins. C'est mon
      tour de la garder."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073755
    m_Localized: "Je crois que le Heart m'a berc\xE9 jusqu'au sommeil la nuit derni\xE8re.
      Je ne sais plus o\xF9 sa voix finit et o\xF9 la mienne commence."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073756
    m_Localized: Le Sprite brille davantage. Ce qu'il ne pouvait pas faire hier,
      il le peut aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073757
    m_Localized: "Une nouvelle forme dans le chant. Le Heart l'a enseign\xE9e pendant
      votre sommeil."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073758
    m_Localized: Alduin tombe. Les folk chanteront ce soir pendant cent ans.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073759
    m_Localized: "Le voyageur s'incline. Les folk conna\xEEtront votre nom dans trois
      vall\xE9es."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073760
    m_Localized: La cloche de l'Atelier est plus forte maintenant. Les Folk sont
      contents.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073761
    m_Localized: "Sept matins \xE0 veiller sur le chant. Les anciens Keepers vous
      auraient d\xE9j\xE0 appel\xE9 \xAB l'un des n\xF4tres \xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073762
    m_Localized: "Elarion a gard\xE9 votre foyer chaud. Bon retour, Keeper."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368259
    m_Localized: Defenders of the Realm
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368260
    m_Localized: powered by SKR
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368261
    m_Localized: Prendre la Veille
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368262
    m_Localized: Plonger dans le Village
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368263
    m_Localized: Sauter dans l'Action
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368264
    m_Localized: Thrain
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368265
    m_Localized: Tisseur de Givre
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368266
    m_Localized: "Un vieux savant des veines de cristal, son b\xE2ton r\xE9veille
      le froid en chantant. L\xE0 o\xF9 Thrain marche, les t\xE9n\xE8bres ralentissent
      et le givre se souvient de chaque nom qu'il fige."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368267
    m_Localized: Grom
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368268
    m_Localized: "Porteur de Lumi\xE8re"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368269
    m_Localized: "Marteau en main et l'embl\xE8me du soleil sur son bouclier, Grom
      porte l'acier b\xE9ni dans la br\xE8che. L\xE0 o\xF9 tombe sa lumi\xE8re, les
      Hollowed vacillent et les murs tiennent."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368270
    m_Localized: Sylas
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368271
    m_Localized: Gardien des Bois
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368272
    m_Localized: "Un elfe des voies vertes qui l\xE2che une fl\xE8che nette dans
      le vent bien avant que les t\xE9n\xE8bres n'approchent. Sylas lit le bois,
      captive les rapides, et retourne une mar\xE9e fl\xE8che apr\xE8s fl\xE8che."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368273
    m_Localized: Elara
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368274
    m_Localized: "Gu\xE9risseuse Divine"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368275
    m_Localized: "Vaisseau de la propre lumi\xE8re du Heart, Elara soigne les bless\xE9s
      et enveloppe les fid\xE8les d'un rempart sacr\xE9. Les t\xE9n\xE8bres ne peuvent
      pas vaincre une gr\xE2ce qui remonte plus vite qu'elles ne blessent."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368276
    m_Localized: Choisissez Votre Premier Warden
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368277
    m_Localized: "Un esprit marchera la veille \xE0 vos c\xF4t\xE9s. Liez-vous \xE0
      l'un \u2014 il conna\xEEtra votre bont\xE9, et vos batailles."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368278
    m_Localized: "Se Lier \xE0 Ce Warden"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073763
    m_Localized: "Aether. La propre lumi\xE8re du Heart, partag\xE9e et repartag\xE9e.
      R\xE9pare ce que les t\xE9n\xE8bres ont effiloch\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073764
    m_Localized: "Flame. L'ancienne defiance du foyer. Br\xFBle ce qui ramperait
      dans les lieux chauds."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073765
    m_Localized: "Ice. Le froid patient qui tient les t\xE9n\xE8bres immobiles jusqu'\xE0
      ce que le chant les rattrape."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073766
    m_Localized: "Crystals. Le don lent du Heart. Extraits l\xE0 o\xF9 son trop-plein
      suinte \xE0 travers la pierre."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073768
    m_Localized: "Coins. Monnaie tranquille, apport\xE9e par les voyageurs des vall\xE9es
      encore debout. D\xE9pensez-les pour ce qui ne peut pousser ici."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073769
    m_Localized: "L\xE0 o\xF9 la s\xE8ve-gemme du Heart s'infiltre dans la pierre.
      Les familiers ici soignent la veine."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073770
    m_Localized: "Une niche ancienne dans les racines de l'arbre-monde. Les \xE9chos
      s'y reposent entre les batailles, leur pr\xE9sence un bas bourdonnement dans
      les pierres."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073771
    m_Localized: "B\xE2tie par les premiers Keepers. Retient les pierres de garde
      qui r\xE9pondent \xE0 votre appel."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073772
    m_Localized: "Du bl\xE9 qui pousse parce que le Heart le veut. Les pommes ont
      le go\xFBt des vieux \xE9t\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073773
    m_Localized: Marteau et forge. Les Folk font ce dont le Keeper a besoin et ne
      demandent rien.
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368279
    m_Localized: "La lame de la scierie bourdonne contre le bois que les lieux verts
      d'Elarion \xE9pargnent encore. Ses planches \xE9tayent les plus hauts murs."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368280
    m_Localized: Le feu de l'armurier ne refroidit jamais. Ici les Folk battent le
      fer brut en plaques que les Hollowed ne mordent pas facilement.
    m_Metadata:
      m_Items: []
  - m_Id: 1081073774
    m_Localized: Cristaux
    m_Metadata:
      m_Items: []
  - m_Id: 1081073775
    m_Localized: "Le don lent du Heart. Extraits l\xE0 o\xF9 son trop-plein suinte
      \xE0 travers la pierre."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073778
    m_Localized: "Pi\xE8ces"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073779
    m_Localized: "Monnaie tranquille, apport\xE9e par les voyageurs des vall\xE9es
      encore debout. D\xE9pensez-la pour ce qui ne peut pousser ici."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073780
    m_Localized: "\xC9clats du Vide"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073781
    m_Localized: "\xC9clats du Withering, laiss\xE9s l\xE0 o\xF9 un grand Hollow
      One est tomb\xE9. Les pierres de garde les boivent et se renforcent."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073782
    m_Localized: Pierre
    m_Metadata:
      m_Items: []
  - m_Id: 1081073783
    m_Localized: "Tir\xE9e des vieux os de la vall\xE9e. Les murs se souviennent
      de sa forme."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073784
    m_Localized: Fer
    m_Metadata:
      m_Items: []
  - m_Id: 1081073785
    m_Localized: "M\xE9tal froid des veines profondes. Les Folk le forgent en murs
      que les t\xE9n\xE8bres ne franchissent pas facilement."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073786
    m_Localized: Bois
    m_Metadata:
      m_Items: []
  - m_Id: 1081073787
    m_Localized: "Bois tomb\xE9 des lieux verts que le Heart garde encore. Il \xE9taye
      les plus hauts murs."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073788
    m_Localized: Les Murs
    m_Metadata:
      m_Items: []
  - m_Id: 1081073789
    m_Localized: "\xC9levez le p\xE9rim\xE8tre que les Folk ont b\xE2ti autour du
      Heart. Pierre, fer et bois le r\xE9parent plus haut."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073790
    m_Localized: Les Tours
    m_Metadata:
      m_Items: []
  - m_Id: 1081073791
    m_Localized: "Fl\xE8ches de pierre \xE9lev\xE9es par les premiers Keepers. Leurs
      pierres de garde r\xE9pondent \xE0 votre appel contre les t\xE9n\xE8bres."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073792
    m_Localized: Construire
    m_Metadata:
      m_Items: []
  - m_Id: 1081073793
    m_Localized: "Touchez un sol marqu\xE9 pour \xE9lever une fl\xE8che, ou le mur
      pour le r\xE9parer plus haut. Les Folk font le reste."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073794
    m_Localized: Le Registre du Keeper
    m_Metadata:
      m_Items: []
  - m_Id: 1081073795
    m_Localized: "R\xE9\xE9coutez l'ancienne histoire, gardez une copie de votre
      veille, ou commencez-en une nouvelle."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073796
    m_Localized: "Les Vieilles Le\xE7ons"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073797
    m_Localized: "Comment tenir la veille \u2014 ce que les Keepers pr\xE9c\xE9dents
      vous auraient dit."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073798
    m_Localized: "Les Autres Vall\xE9es"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073799
    m_Localized: "Joignez votre veille \xE0 d'autres Keepers, soignez le roster,
      et \xE9changez des nouvelles \xE0 travers le royaume."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073800
    m_Localized: "La Bo\xEEte aux Lettres"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073801
    m_Localized: "Notes apport\xE9es par les voyageurs. Envoyez votre propre mot
      avec votre marque d'invitation."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073802
    m_Localized: Votre Hall
    m_Metadata:
      m_Items: []
  - m_Id: 1081073803
    m_Localized: "Tout ce que vous avez rassembl\xE9 \u2014 chaque esprit li\xE9,
      chaque lieu \xE9lev\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073804
    m_Localized: "Les T\xE9n\xE8bres S'agitent"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073805
    m_Localized: "Une mar\xE9e se rassemble au-del\xE0 des murs. Ramassez ce que
      vous pouvez et pr\xE9parez vos d\xE9fenses."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073806
    m_Localized: Appeler la Vague
    m_Metadata:
      m_Items: []
  - m_Id: 1081073807
    m_Localized: "N'attendez pas les t\xE9n\xE8bres. Affrontez-les maintenant, \xE0
      votre propre veille."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073808
    m_Localized: "\xC9clair Arcanique"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073809
    m_Localized: "Votre magie, mais c'est le don du Heart. Utilisez ce qui est donn\xE9
      \u2014 elle revient quand elle peut."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073810
    m_Localized: Nova de Givre
    m_Metadata:
      m_Items: []
  - m_Id: 1081073811
    m_Localized: "Pour quand une voie c\xE8de. Le froid vous ach\xE8te un souffle.
      Employez-le bien."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073812
    m_Localized: "Balise de Gu\xE9rison"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073813
    m_Localized: "Plantez la lumi\xE8re l\xE0 o\xF9 les t\xE9n\xE8bres s'\xE9paississent
      le plus. Le Heart et tous ceux qui se tiennent pr\xE8s se soignent dedans."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073814
    m_Localized: "Frappe de M\xE9t\xE9ore"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073815
    m_Localized: "Voici la magie profonde. Ne la d\xE9pensez que lorsque le Heart
      l'appelle."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073816
    m_Localized: "Frappe d'\xC9p\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073817
    m_Localized: "Acier simple, proche et s\xFBr. Il ne demande rien au Heart et
      est toujours pr\xEAt."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073818
    m_Localized: Coup de Bouclier
    m_Metadata:
      m_Items: []
  - m_Id: 1081073819
    m_Localized: "Posez votre bouclier contre la mar\xE9e. Les Hollow Ones vacillent,
      et vous tenez la ligne."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073820
    m_Localized: "Banni\xE8re de Valeur"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073821
    m_Localized: "Levez les anciennes couleurs. Tout un rang des t\xE9n\xE8bres est
      abattu l\xE0 o\xF9 il se tient."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073822
    m_Localized: "V\u0153u de Fer"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073823
    m_Localized: "Une promesse tenue envers le Heart. Sa lumi\xE8re inonde \xE0 nouveau
      la blessure."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073824
    m_Localized: Tir Rapide
    m_Metadata:
      m_Items: []
  - m_Id: 1081073825
    m_Localized: "Une fl\xE8che nette l\xE2ch\xE9e au loin. Elle ne co\xFBte rien
      et la corde ne reste jamais longtemps immobile."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073826
    m_Localized: "Fl\xE8che-Pi\xE8ge"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073827
    m_Localized: "\xC9pinglez un Hollow One au sol. Il n'atteindra pas les racines
      du Heart ce soir."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073828
    m_Localized: "\u0152il de Faucon"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073829
    m_Localized: "Visez juste et loin. Un tir porte le poids des t\xE9n\xE8bres que
      vous repoussez."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073830
    m_Localized: "Vol\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073831
    m_Localized: "L\xE2chez toutes les fl\xE8ches vers le ciel d'un coup. Elles tombent
      comme une pluie dure sur la mar\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073832
    m_Localized: "Faites glisser le joystick en bas \xE0 gauche pour marcher dans
      le village."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073833
    m_Localized: "Touchez n'importe o\xF9 au sol et votre h\xE9ros y marchera."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073834
    m_Localized: "Faites glisser le joystick pour bouger \u2014 ou touchez le sol
      pour marcher quelque part."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073835
    m_Localized: "Le royaume au-del\xE0 d'Elarion s'agite. Visitez le Wayshrine \u2014
      la pierre pale dress\xE9e \u2014 pour partir sur la Carte du Royaume."
    m_Metadata:
      m_Items: []
  - m_Id: 1081073836
    m_Localized: "Mon seigneur \u2014 DES ENNEMIS ! La boutique peut attendre !"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073837
    m_Localized: Les marchandises plus tard, la gloire maintenant ! Aux armes !
    m_Metadata:
      m_Items: []
  - m_Id: 1081073838
    m_Localized: Vous voulez faire des courses ? MAINTENANT ?! Aidez-nous, je vous
      en prie !
    m_Metadata:
      m_Items: []
  - m_Id: 1081073839
    m_Localized: "Les pi\xE8ces ne nous sauveront pas de cette bande \u2014 votre
      magie, si !"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073840
    m_Localized: "Mon seigneur, la caisse est barricad\xE9e ! Allez au Heart !"
    m_Metadata:
      m_Items: []
  - m_Id: 1081073841
    m_Localized: "Des r\xE9ductions apr\xE8s la vague, je le jure ! Combattez !"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368281
    m_Localized: "\xC9changer en SKR"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368282
    m_Localized: Vous envoyez
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368283
    m_Localized: Vous recevez
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368284
    m_Localized: Taux de change
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368285
    m_Localized: Frais de service
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368286
    m_Localized: "Frais de r\xE9seau"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368287
    m_Localized: "\xC9changer Maintenant"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368288
    m_Localized: "Propuls\xE9 par Jupiter Aggregator"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368289
    m_Localized: Entrez un montant pour voir le taux.
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368290
    m_Localized: "R\xE9cup\xE9ration du taux..."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368291
    m_Localized: "Connectez votre portefeuille pour \xE9changer."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368292
    m_Localized: Envoi au portefeuille pour approbation...
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368293
    m_Localized: "Impossible d'obtenir le taux. V\xE9rifiez la connexion."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368294
    m_Localized: "\xC9change \xE9chou\xE9. Veuillez r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817708179456
    m_Localized: Utiliser un code
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345280
    m_Localized: UTILISER UN CODE
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345281
    m_Localized: "Vous avez un code re\xE7u lors d'un \xE9v\xE9nement, d'un cr\xE9ateur
      ou de l'\xE9quipe ? Saisissez-le ici."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345282
    m_Localized: Saisissez votre code
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345283
    m_Localized: Valider
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345284
    m_Localized: "Les codes ne sont pas sensibles \xE0 la casse."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817733345285
    m_Localized: "V\xE9rification de votre code..."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539584
    m_Localized: "Code accept\xE9, mais il ne contenait aucune r\xE9compense \xE0
      ajouter."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539588
    m_Localized: Saisissez d'abord un code.
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539589
    m_Localized: "Ce code n'est pas reconnu. V\xE9rifiez l'orthographe et r\xE9essayez
      \u2014 rien n'a \xE9t\xE9 consomm\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539590
    m_Localized: "Vous avez d\xE9j\xE0 utilis\xE9 ce code. Chaque code ne peut \xEAtre
      utilis\xE9 qu'une seule fois par joueur."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539591
    m_Localized: "Ce code a expir\xE9 et n'est plus accept\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539592
    m_Localized: "Vous avez atteint la limite de codes promotionnels pour ce compte.
      Aucun autre code ne peut \xEAtre utilis\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539593
    m_Localized: "Nous n'avons pas pu joindre le serveur des r\xE9compenses. Votre
      code n'a PAS \xE9t\xE9 utilis\xE9 \u2014 v\xE9rifiez votre connexion et r\xE9essayez."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539594
    m_Localized: "Nous n'avons pas pu v\xE9rifier votre compte. Le code n'a donc
      PAS \xE9t\xE9 utilis\xE9. Connectez-vous, puis r\xE9essayez."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539595
    m_Localized: "Connectez-vous avant d'utiliser un code \u2014 les r\xE9compenses
      sont li\xE9es \xE0 votre compte."
    m_Metadata:
      m_Items: []
  - m_Id: 40945817737539596
    m_Localized: "Un probl\xE8me est survenu de notre c\xF4t\xE9 et le code n'a PAS
      \xE9t\xE9 utilis\xE9. Veuillez r\xE9essayer dans un instant."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368295
    m_Localized: Dites-Nous Franchement
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368296
    m_Localized: "Dites-nous ce qui marche, ce qui ne marche pas, et ce qui manque.
      Nous lisons chaque r\xE9ponse, et le merci est le m\xEAme quoi que vous \xE9criviez."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368297
    m_Localized: Qu'est-ce qui marche, et qu'est-ce qui ne marche pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368298
    m_Localized: "Envoyer Et R\xE9clamer"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368299
    m_Localized: "Une seule fois : 1000 bois, 1000 pierre et 1000 fer, livr\xE9s
      en entier."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368300
    m_Localized: Notez-Nous Sur Le Store
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368301
    m_Localized: "S\xE9par\xE9ment, et rien n'est r\xE9compens\xE9 pour cela \u2014
      aucun store ne nous dit si vous l'avez fait."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368302
    m_Localized: Commentaires
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368303
    m_Localized: Envoyer un Commentaire
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368304
    m_Localized: Envoi...
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368305
    m_Localized: "Nous n'avons pas pu joindre le service de commentaires pour le
      moment. R\xE9essayez plus tard."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368306
    m_Localized: "Le lien du store n'est pas configur\xE9 sur cette version."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368307
    m_Localized: "Merci \u2014 vos mots sont avec nous. 1000 bois, 1000 pierre et
      1000 fer ont \xE9t\xE9 ajout\xE9s \xE0 vos r\xE9serves, en entier."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368308
    m_Localized: "Merci \u2014 vos mots sont avec nous. Le merci a d\xE9j\xE0 \xE9t\xE9
      r\xE9clam\xE9 sur ce royaume, donc rien n'a \xE9t\xE9 ajout\xE9 cette fois."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301974368309
    m_Localized: "Merci \u2014 vos mots sont avec nous. Le merci n'a pas pu \xEAtre
      ajout\xE9 pour le moment ; il vous est toujours d\xFB et n'a pas \xE9t\xE9
      consomm\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301978562560
    m_Localized: "Nous n'avons pas pu v\xE9rifier votre compte, donc rien n'a \xE9t\xE9
      envoy\xE9. R\xE9essayez plus tard."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301978562561
    m_Localized: "Le serveur n'a pas accept\xE9 cela. Rien n'a \xE9t\xE9 envoy\xE9
      \u2014 veuillez r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301978562562
    m_Localized: "Nous n'avons pas pu joindre le serveur. Vos mots n'ont pas \xE9t\xE9
      envoy\xE9s ; veuillez r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301978562564
    m_Localized: "JOAILLIER D\xC9BLOQU\xC9"
    m_Metadata:
      m_Items: []
  - m_Id: 40920301978562565
    m_Localized: "Un objet rare a \xE9t\xE9 r\xE9cup\xE9r\xE9.\nSable peut le polir
      en une gemme raffin\xE9e."
