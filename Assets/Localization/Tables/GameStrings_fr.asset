      m_Items: []
  - m_Id: 40920301978562569
    m_Localized: "Stake SKR natif v\xE9rifi\xE9 : +1 relance hebdomadaire ajout\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 40920301978562570
    m_Localized: "Stake SKR natif v\xE9rifi\xE9 : +1 relance hebdomadaire ajout\xE9e.
      Votre stake de 10 000+ SKR \xE9l\xE8ve aussi le plafond de jet par pierre \xE0
