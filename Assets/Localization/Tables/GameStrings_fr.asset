      m_Items: []
  - m_Id: 44124330363760904
    m_Localized: "Rien \u00E0 faire pour cet objet."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760905
    m_Localized: "S\u00E9lectionnez un objet \u00E0 am\u00E9liorer."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760906
    m_Localized: "Tu dois le poss\u00E9der avant de pouvoir l'am\u00E9liorer."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760907
    m_Localized: "Cet objet ne peut pas \u00EAtre am\u00E9lior\u00E9."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760908
    m_Localized: "L'am\u00E9lioration a \u00E9chou\u00E9."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760909
    m_Localized: "POLIR \u00C0 NOUVEAU?"
