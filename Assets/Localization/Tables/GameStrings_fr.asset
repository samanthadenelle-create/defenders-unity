    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760961
    m_Localized: "Appuyez sur une comp\u00E9tence, puis sur un emplacement de commutation rapide."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760962
    m_Localized: "Impossible de changer les comp\u00E9tences pendant la bataille."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760963
    m_Localized: "Emplacement vid\u00E9."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760964
    m_Localized: "Choisissez d'abord une comp\u00E9tence."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760965
    m_Localized: "Assign\u00E9 \u00E0 l'emplacement de commutation rapide {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760966
    m_Localized: "Cette comp\u00E9tence est d\u00E9j\u00E0 dans la barre."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760967
    m_Localized: "Ajout\u00E9 \u00E0 votre barre de commutation rapide."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760968
    m_Localized: "Aucun emplacement libre (ou d\u00E9j\u00E0 dans la barre)."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760969
    m_Localized: "Touchez maintenant un emplacement de commutation rapide."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760970
    m_Localized: "Choisissez d'abord une comp\u00E9tence, puis touchez un emplacement."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760971
    m_Localized: "Continuer avec Google"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760972
    m_Localized: "Connecter le portefeuille"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760973
    m_Localized: "Points d'Escouade: {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760974
    m_Localized: "MON CH\u00C2TEAU  *"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760975
    m_Localized: "UTILISER MON CH\u00C2TEAU"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760976
    m_Localized: "Cet emplacement est d\u00E9j\u00E0 vide."
    m_Metadata:
      m_Items: []

