      m_Items: []
  - m_Id: 44124330363760931
    m_Localized: "Temps! Retrait vers le ch\u00E2teau..."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760932
    m_Localized: "Retrait vers le ch\u00E2teau..."
    m_Metadata:
      m_Items: []
