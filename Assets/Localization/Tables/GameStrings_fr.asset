    m_Metadata:
      m_Items: []
  - m_Id: 41003251969601537
    m_Localized: "Les packs de plus de {Threshold} n\xE9cessitent un portefeuille
      connect\xE9 afin que vos achats restent \xE0 vous si vous r\xE9installez le
      jeu ou changez de t\xE9l\xE9phone. Connectez un portefeuille pour acheter ce
      pack ; vous pouvez acheter d\xE8s maintenant sans portefeuille tout pack \xE0
      {Threshold} ou moins."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143555
  - m_Id: 41003251969601538
    m_Localized: "Connectez un portefeuille afin que cet achat reste \xE0 vous sur
