      m_Items: []
  - m_Id: 44124330363760874
    m_Localized: "Emplacement de file suppl\u00E9mentaire achet\u00E9 - la file d'attente peut contenir {0} \u00E9l\u00E9ments."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760875
    m_Localized: "Toutes les am\u00E9liorations ici sont d\u00E9j\u00E0 d\u00E9verrouill\u00E9es."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760876
    m_Localized: "N\u00E9cessite le Niveau C\u0153ur {0} (tu as {1})."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760877
    m_Localized: "En construction \u2014 {0}s jusqu'\u00E0 ce que les travaux ici se terminent."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760878
    m_Localized: "Tier {0} d\u00E9verrouill\u00E9."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760879
    m_Localized: "Tu ne peux pas encore te le permettre."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760880
    m_Localized: "Niveau {0} d\u00E9verrouill\u00E9."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760881
    m_Localized: "Cette am\u00E9lioration a besoin de Magie pour \u00EAtre d\u00E9verrouill\u00E9e."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760882
    m_Localized: "En construction \u2014 termine le travail actuel en premier."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760883
    m_Localized: "Am\u00E9lioration en attente - elle commence quand un constructeur se lib\u00E8re."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760884
    m_Localized: "Am\u00E9lioration en cours - {0}s."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760885
    m_Localized: "Rien \u00E0 d\u00E9verrouiller ici."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760886
    m_Localized: "Le C\u0153ur est d\u00E9j\u00E0 \u00E0 son niveau le plus \u00E9lev\u00E9."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760887
    m_Localized: "Tu as besoin de {0} Cristaux pour \u00E9lever le C\u0153ur (tu as {1})."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760888
    m_Localized: "Niveau du C\u0153ur augment\u00E9 \u00E0 {0} \u2014 am\u00E9liorations sup\u00E9rieures d\u00E9verrouill\u00E9es."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760889
    m_Localized: "N'a pas pu \u00E9lever le C\u0153ur en ce moment."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760890
    m_Localized: "Recherche commenc\u00E9e - v\u00E9rifie la file de Recherche."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760891
    m_Localized: "Tu ne peux pas encore d\u00E9verrouiller cet avantage."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760892
    m_Localized: "Appuie sur la tuile dor\u00E9e pour d\u00E9verrouiller l'am\u00E9lioration suivante."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760893
    m_Localized: "annul\u00E9 - tu as boug\u00E9. Immobilise-toi pour tirer."
