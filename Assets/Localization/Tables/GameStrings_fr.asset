      m_Items: []
  - m_Id: 44124330363760918
    m_Localized: "Impossible de d\u00E9ployer {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760919
    m_Localized: "Br\u00E8che: appuie sur une section de mur pour ordonner l'assaut."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760920
    m_Localized: "Br\u00E8che: ce n'est pas un mur - appuie sur une section de mur."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760921
    m_Localized: "Br\u00E8che: cette section est d\u00E9j\u00E0 \u00E9croul\u00E9e."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760922
    m_Localized: "Br\u00E8che: ce mur n'appartient pas \u00E0 l'ennemi."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760923
    m_Localized: "Br\u00E8che ordonn\u00E9e - la bande de guerre attaque cette section."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760924
    m_Localized: "Ordre de br\u00E8che annul\u00E9 - la bande choisit le mur le plus faible \u00E0 nouveau."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760925
    m_Localized: "Br\u00E8che ACTIV\u00C9E"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760926
    m_Localized: "Br\u00E8che"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760927
    m_Localized: "Point de ralliement d\u00E9fini \u2014 les troupes inactives s'y rassembleront."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760928
    m_Localized: "Rallier"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760929
    m_Localized: "Retraite ? Appuie \u00E0 nouveau pour confirmer \u2014 les tomb\u00E9s sont perdus, et certains survivants ne reviendront pas."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760930
    m_Localized: "Confirmer Retraite"
