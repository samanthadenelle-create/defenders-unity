  - m_Id: 44124330363761068
    m_Localized: "Anillo"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761069
    m_Localized: "vac\u00EDo"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761070
    m_Localized: "Gestiona tu equipo"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761071
    m_Localized: "Toca una ranura a la izquierda para examinar art\u00EDculos para esa posici\u00F3n."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761072
    m_Localized: "ESPACIOS DISPONIBLES: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761073
    m_Localized: "EQUIPADO"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761074
    m_Localized: "DETALLES DEL ART\u00CDCULO"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761075
    m_Localized: "Servicios, registros y consejos del reino."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761076
    m_Localized: "Tu equipamiento, inventario, habilidades, configuraci\u00F3n y vestuario."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761077
    m_Localized: "Tu equipamiento, inventario, habilidades y configuraci\u00F3n."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761078
    m_Localized: "Tus misiones y los campamentos que tu ej\u00E9rcito puede asaltar."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761079
    m_Localized: "Todo lo que llevas encima"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761080
    m_Localized: "Equipamiento"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761081
    m_Localized: "Lo que tu h\u00E9roe lleva puesto"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761082
    m_Localized: "Aprende y mejora habilidades"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761083
    m_Localized: "Aptitudes preparadas para la batalla"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761084
    m_Localized: "Vestuario"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761085
    m_Localized: "Aspectos para tu h\u00E9roe, tu Eco y tu aldea"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761086
    m_Localized: "NUEVO"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761087
