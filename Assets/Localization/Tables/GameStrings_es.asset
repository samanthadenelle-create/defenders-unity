    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761094
    m_Localized: "INVESTIGACI\u00D3N"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761095
    m_Localized: "Construye y mejora tu aldea"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761096
    m_Localized: "Entrena y gestiona tus tropas"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761097
    m_Localized: "Desbloquea avances poderosos"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761098
