  - m_Id: 44124330363761064
    m_Localized: "Mano Principal"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761065
    m_Localized: "Mano Izquierda"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761066
    m_Localized: "Armadura"
    m_Metadata:
