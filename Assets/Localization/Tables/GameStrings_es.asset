    m_Localized: "CONFIGURACI\xD3N"
    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491899
    m_Localized: "Desciende a lugares olvidados. Regresa con lo que sobrevivi\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491900
    m_Localized: "Explora las tierras m\xE1s all\xE1 de la luz del Heart."
    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491901
    m_Localized: "Enfrenta el desaf\xEDo que ahora moldea el Reino."
    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491902
    m_Localized: "El camino est\xE1 cerrado."
    m_Metadata:
      m_Items: []
