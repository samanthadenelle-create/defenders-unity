    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491850
    m_Localized: "Una ventana de construcci\xF3n larga y calmada: unos 10 minutos
      entre oleadas."
    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491851
    m_Localized: "La ventana de construcci\xF3n est\xE1ndar: unos 5 minutos entre
      oleadas."
    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491852
    m_Localized: "Una ventana de construcci\xF3n corta y tensa: unos 3 minutos entre
      oleadas."
    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491853
