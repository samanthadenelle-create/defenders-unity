    m_Localized: "Coraz\xF3n de Elarion"
    m_Metadata:
      m_Items: []
  - m_Id: 40992049398853632
    m_Localized: Defiende el reino
    m_Metadata:
      m_Items: []
  - m_Id: 40992049398853633
    m_Localized: "Prep\xE1rate para la pr\xF3xima oleada."
