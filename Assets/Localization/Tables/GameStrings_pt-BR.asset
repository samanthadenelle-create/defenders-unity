  - m_Id: 44124330363761068
    m_Localized: "Anel"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761069
    m_Localized: "vazio"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761070
    m_Localized: "Gerencie seu equipamento"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761071
    m_Localized: "Toque em um espa\u00E7o \u00E0 esquerda para procurar itens para essa posi\u00E7\u00E3o."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761072
    m_Localized: "ESPA\u00C7OS ABERTOS: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761073
    m_Localized: "EQUIPADO"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761074
    m_Localized: "DETALHES DO ITEM"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761075
    m_Localized: "Servi\u00E7os, registros e orienta\u00E7\u00E3o do reino."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761076
    m_Localized: "Seu equipamento, invent\u00E1rio, habilidades, configura\u00E7\u00E3o e guarda-roupa."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761077
    m_Localized: "Seu equipamento, invent\u00E1rio, habilidades e configura\u00E7\u00E3o."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761078
    m_Localized: "Suas miss\u00F5es e os acampamentos que seu ex\u00E9rcito pode atacar."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761079
    m_Localized: "Tudo o que voc\u00EA carrega"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761080
    m_Localized: "Equipamento"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761081
    m_Localized: "O que seu her\u00F3i est\u00E1 usando"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761082
    m_Localized: "Aprenda e melhore habilidades"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761083
    m_Localized: "Aptid\u00F5es preparadas para a batalha"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761084
    m_Localized: "Guarda-roupa"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761085
    m_Localized: "Apar\u00EAncias para seu her\u00F3i, seu Eco e sua vila"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761086
    m_Localized: "NOVO"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761087
    m_Localized: "NOVO - {0}"
    m_Metadata:
      m_Items: []
