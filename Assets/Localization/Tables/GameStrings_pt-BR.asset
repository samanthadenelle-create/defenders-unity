    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761065
    m_Localized: "M\u00E3o Esquerda"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761066
    m_Localized: "Armadura"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761067
    m_Localized: "Amuleto"
    m_Metadata:
