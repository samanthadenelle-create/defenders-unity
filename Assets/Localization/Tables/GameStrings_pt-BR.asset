    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491851
    m_Localized: "A janela de constru\xE7\xE3o padr\xE3o \u2014 cerca de 5 minutos
      entre ondas."
    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491852
    m_Localized: "Uma janela de constru\xE7\xE3o curta e tensa \u2014 cerca de 3
