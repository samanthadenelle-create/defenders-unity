    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761090
    m_Localized: "Ex\u00E9rcito {0} / {1} . {2} acampamento aberto"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761091
    m_Localized: "Ex\u00E9rcito {0} / {1} . nenhum acampamento ao alcance"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761092
    m_Localized: "FILA"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761093
    m_Localized: "EX\u00C9RCITO"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761094
    m_Localized: "PESQUISA"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761095
    m_Localized: "Construa e melhore sua vila"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761096
    m_Localized: "Treine e gerencie suas tropas"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761097
    m_Localized: "Desbloqueie avan\u00E7os poderosos"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761098
    m_Localized: "Habilidades atribu\u00EDdas: mude-as em {0}."
    m_Metadata:
      m_Items: []

