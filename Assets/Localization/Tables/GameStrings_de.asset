    m_Localized: '[BEREIT] Bereit'
    m_Metadata:
      m_Items: []
  - m_Id: 41016777618534400
    m_Localized: "[WARTEN] Wallet wird ge\xF6ffnet - meist unter 2 Sekunden"
    m_Metadata:
      m_Items: []
  - m_Id: 41016777618534401
    m_Localized: "[AKTION] Warte auf deine Freigabe - in der Wallet best\xE4tigen
