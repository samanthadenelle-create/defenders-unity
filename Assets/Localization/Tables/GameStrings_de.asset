  - m_Id: 44124330363761073
    m_Localized: "AUSGER\xDCSTET"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761074
    m_Localized: GEGENSTANDSDETAILS
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761075
    m_Localized: "Dienste, Aufzeichnungen und Ratschl\xE4ge des Reichs."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761076
    m_Localized: "Deine Ausr\xFCstung, dein Inventar, F\xE4higkeiten, Konfiguration
      und Garderobe."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761077
    m_Localized: "Deine Ausr\xFCstung, dein Inventar, F\xE4higkeiten und Konfiguration."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761078
    m_Localized: "Deine Auftr\xE4ge und die Lager, die dein Heer \xFCberfallen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761079
    m_Localized: Alles, was du bei dir tragst
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761080
    m_Localized: "Ausr\xFCstung"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761081
    m_Localized: "Was dein Held tr\xE4gt"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761082
    m_Localized: "F\xE4higkeiten lernen und verbessern"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761083
    m_Localized: "F\xFCr den Kampf ger\xFCstete Fertigkeiten"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761084
    m_Localized: Garderobe
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761085
    m_Localized: "Looks f\xFCr deinen Helden, deinen Echo und deine Stadt"
    m_Metadata:
      m_Items: []
