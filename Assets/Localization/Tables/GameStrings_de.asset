    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760795
    m_Localized: Verteidiger
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760796
    m_Localized: "Ausdr\xFCcklich freigegebene Momentaufnahme wird geladen ..."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760797
    m_Localized: Diese Stadt kann nicht besucht werden.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760798
    m_Localized: Diese Momentaufnahme der Stadt konnte nicht sicher angezeigt werden.
    m_Metadata:
      m_Items: []
