  - m_Id: 44124330363760780
    m_Localized: "F\xE4higkeit hinzuf\xFCgen, um sie zu aktivieren"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760781
    m_Localized: Stadt besuchen
