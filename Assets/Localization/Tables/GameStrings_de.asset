      m_Items: []
  - m_Id: 40931158179491850
    m_Localized: "Ein langes, ruhiges Baufenster \u2014 etwa 10 Minuten zwischen
      Wellen."
    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491851
    m_Localized: "Das Standard-Baufenster \u2014 etwa 5 Minuten zwischen Wellen."
    m_Metadata:
      m_Items: []
  - m_Id: 40931158179491852
    m_Localized: "Ein kurzes, angespanntes Baufenster \u2014 etwa 3 Minuten zwischen
      Wellen."
    m_Metadata:
      m_Items: []
