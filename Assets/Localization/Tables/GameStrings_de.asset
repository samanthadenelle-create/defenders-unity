  - m_Id: 44124330363760712
    m_Localized: "\xDCberspringen >"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760713
    m_Localized: "Tutorial \xFCberspringen"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760714
    m_Localized: "Tutorial \xFCberspringen? Du beh\xE4ltst alles, was es gew\xE4hrt."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760715
    m_Localized: Weiterspielen
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760716
    m_Localized: "Anleitung \xFCberspringen? Dein Fortschritt ist gespeichert."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760717
    m_Localized: Wie SKR das Reich antreibt
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760718
    m_Localized: "Die Seeker-/Solana-Token-Integration \u2014 die vorgesehene Erfahrung."
