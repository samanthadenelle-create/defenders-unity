      m_Items: []
  - m_Id: 44124330363761304
    m_Localized: Only the Zirkel leader can register a vault.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761305
    m_Localized: A signer could not be accepted.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761306
    m_Localized: This Zirkel already has a vault.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761307
    m_Localized: The vault could not be read right now. Try again in a moment.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761308
    m_Localized: Clear Rubble ({0} left)  +{1}
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363761309
    m_Localized: Next Ruin
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761310
    m_Localized: Rubble cleared. Salvaged {0}.
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44636558924533760
    m_Localized: Sign in with your wallet to open Circle Chat.
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088192
    m_Localized: SIGN IN
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088193
    m_Localized: The Circle of {0} held vigil.
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44636558958088194
    m_Localized: The Circle of {0} has chosen {1}. The Heart has heard.
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44636558958088195
    m_Localized: CONTINUE
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088196
    m_Localized: Watch the last vigil
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088197
    m_Localized: 'The vigil continues. Next epoch: {0}.'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44636558958088198
    m_Localized: Ember
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088199
    m_Localized: Flame
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088200
    m_Localized: Beacon
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088201
    m_Localized: Pyre
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088202
    m_Localized: Dawn
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088203
    m_Localized: A spark moves beneath the roots. The Circle has begun.
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088204
    m_Localized: The Circle keeps its watch. The Heart is warm.
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088205
    m_Localized: The Heart answers. Light climbs the trunk.
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088206
    m_Localized: The crown blooms. The ancestors are near.
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088207
    m_Localized: The canopy shifts. The Circle has been heard.
    m_Metadata:
      m_Items: []
  - m_Id: 44636558958088208
    m_Localized: Connect your wallet to see your Circle.
    m_Metadata:
      m_Items: []
