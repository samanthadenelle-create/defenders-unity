  - m_Id: 44124330363761134
    m_Localized: '1 foe felled. '
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761135
    m_Localized: Defeat
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761136
    m_Localized: Fall back and regroup, hero.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761137
    m_Localized: YOU HAVE FALLEN
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761138
    m_Localized: The raid is lost. You retreat to the castle to fight another day.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761139
    m_Localized: The dark takes you, but Elarion still needs its defender.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761140
    m_Localized: Rise again
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761141
    m_Localized: Try Again
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761142
    m_Localized: Victory!
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761143
    m_Localized: Return to Castle
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761144
