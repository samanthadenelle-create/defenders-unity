      - rid: 7338888477077143554
  - m_Id: 44124330363760848
    m_Localized: Kein Wallet verbunden
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760849
    m_Localized: 'Musik: Ein'
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760850
    m_Localized: 'Musik: Aus'
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760851
    m_Localized: Musik ein
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760852
    m_Localized: Musik aus
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760853
    m_Localized: PAUSE
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760854
    m_Localized: Fortsetzen
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760855
    m_Localized: Zum Titelbildschirm
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760856
    m_Localized: Sitzung reparieren
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760857
    m_Localized: "Das setzt einen h\xE4ngenden Bildschirmzustand zur\xFCck. Dein
      Fortschritt bleibt unber\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760858
    m_Localized: Reparieren
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760859
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760860
    m_Localized: "Gib einen g\xFCltigen Betrag ein."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760861
    m_Localized: '{0} ist am Zug'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760862
    m_Localized: Wanderung durchs Reich
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760863
    m_Localized: Elarion (Stadtthema)
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760864
    m_Localized: Echoes of Elarion (Hauptthema)
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760865
    m_Localized: "W\xE4hle die Musik f\xFCr deinen Aufenthaltsort. In K\xE4mpfen
      \xFCbernimmt weiterhin die Kampfmusik."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760866
    m_Localized: Audio ist noch nicht bereit.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760867
    m_Localized: "\xDCberspringen  >"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760868
    m_Localized: DEFENDERS OF THE REALM
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760869
    m_Localized: Echoes of Elarion
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760870
    m_Localized: "Sichere K\xE4ufe \xFCber Google Play"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760871
    m_Localized: "K\xE4ufe gepr\xFCft und wiederhergestellt."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760872
    m_Localized: Wiederherstellung fehlgeschlagen.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760873
    m_Localized: "Bauwarteschlangen werden derzeit nicht ausgef\xFChrt."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760874
    m_Localized: "Zus\xE4tzlicher Warteschlangen-Slot gekauft - die Warteschlange
      kann {0} Elemente aufnehmen."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760875
    m_Localized: Alle Verbesserungen hier sind bereits freigeschaltet.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760876
    m_Localized: Erfordert Herz-Stufe {0} (du hast {1}).
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760877
    m_Localized: "Im Bau \u2014 {0}s bis die Arbeiten hier fertig sind."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760878
    m_Localized: Stufe {0} freigeschaltet.
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760879
    m_Localized: Du kannst dir das noch nicht leisten.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760880
    m_Localized: Stufe {0} freigeschaltet.
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760881
    m_Localized: "Diese Verbesserung ben\xF6tigt Magie zum Freischalten."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760882
    m_Localized: "Im Bau \u2014 beende zuerst die aktuelle Arbeit."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760883
    m_Localized: Verbesserung in Warteschlange - beginnt, wenn ein Baumeister frei
      wird.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760884
    m_Localized: Verbesserung im Bau - {0}s.
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760885
    m_Localized: Hier gibt es nichts zum Freischalten.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760886
    m_Localized: "Das Herz ist bereits auf seiner h\xF6chsten Stufe."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760887
    m_Localized: "Du brauchst {0} Kristalle, um das Herz zu erh\xF6hen (du hast {1})."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760888
    m_Localized: "Herz-Stufe auf {0} erh\xF6ht \u2014 h\xF6here Verbesserungen freigeschaltet."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760889
    m_Localized: "Konnte das Herz gerade nicht erh\xF6hen."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760890
    m_Localized: "Forschung gestartet - \xFCberpr\xFCfe die Forschungswarteschlange."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760891
    m_Localized: Du kannst diesen Vorteil noch nicht freischalten.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760892
    m_Localized: "Tippe auf die goldene Kachel, um die n\xE4chste Verbesserung freizuschalten."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760893
    m_Localized: "abgebrochen - du hast dich bewegt. Bleib still, um zu schie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760894
    m_Localized: ANLEGEN
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760895
    m_Localized: ENTFERNEN
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760896
    m_Localized: "ZUR\xDCCK"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760897
    m_Localized: "Ausr\xFCstung ablegen"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760899
    m_Localized: "Keine kompatiblen Gegenst\xE4nde besessen."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760900
    m_Localized: "W\xE4hle ein Element zum Vergleichen aus."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760901
    m_Localized: "W\xE4hle ein Element zum Anlegen aus."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760902
    m_Localized: Du musst es kaufen, bevor du es anlegen kannst.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760903
    m_Localized: Dieser Gegenstand kann nicht angelegt werden.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760904
    m_Localized: "Nichts zu tun f\xFCr diesen Artikel."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760905
    m_Localized: "W\xE4hle ein Element zum Verbessern aus."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760906
    m_Localized: Du musst es besitzen, bevor du es verbessern kannst.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760907
    m_Localized: Dieser Gegenstand kann nicht verbessert werden.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760908
    m_Localized: Verbesserung fehlgeschlagen.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760909
    m_Localized: NOCHMALS POLIEREN?
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760910
    m_Localized: 'Du riskierst: {0}'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760911
    m_Localized: "Es k\xF6nnte zu jedem dieser werden:"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760912
    m_Localized: "Es besteht eine {0}%ige Chance, dass der Stein zerst\xF6rt wird
      und du nichts bekommst."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760913
    m_Localized: BEHALTEN
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760914
    m_Localized: NOCHMALS POLIEREN
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760915
    m_Localized: "Dort kann nicht platziert werden - tippe auf offenes Gel\xE4nde
      in der Basis."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760916
    m_Localized: "Keine Armee zum Eins\xE4tzen."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760917
    m_Localized: "Keine {0} mehr bereit zum Eins\xE4tzen."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760918
    m_Localized: Konnte {0} nicht einsetzen.
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760919
    m_Localized: 'Bresche: Tippe auf einen Mauerteil, um den Angriff zu befehlen.'
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760920
    m_Localized: 'Bresche: Das ist keine Mauer - tippe auf einen Mauerteil.'
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760921
    m_Localized: "Bresche: Dieser Teil ist bereits zerst\xF6rt."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760922
    m_Localized: "Bresche: Diese Mauer geh\xF6rt nicht dem Feind."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760923
    m_Localized: Bresche befohlen - das Kriegsheer greift diesen Teil an.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760924
    m_Localized: "Bresche-Befehl aufgehoben - das Kriegsheer sucht sich die schw\xE4chste
      Mauer aus."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760925
    m_Localized: Bresche AN
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760926
    m_Localized: Bresche
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760927
    m_Localized: "Sammelplatz gesetzt \u2014 unt\xE4tige Truppen sammeln sich dort."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760928
    m_Localized: Sammeln
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760929
    m_Localized: "R\xFCckzug? Tippe erneut zur Best\xE4tigung \u2014 die Gefallenen
      sind verloren, und einige \xDCberlebende kehren nicht zur\xFCck."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760930
    m_Localized: "R\xFCckzug best\xE4tigen"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760931
    m_Localized: "Zeit! R\xFCckzug zum Schloss..."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760932
    m_Localized: "R\xFCckzug zum Schloss..."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760934
    m_Localized: Alle einsetzen
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760935
    m_Localized: "Keine Truppen zum Eins\xE4tzen - trainiere zuerst in der Kaserne."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760936
    m_Localized: "Alle einsetzen nicht verf\xFCgbar - keine Armee bereit oder Held."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760937
    m_Localized: "Alle einsetzen ben\xF6tigt offenes Gel\xE4nde davor."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760938
    m_Localized: Alle bereiten Truppen sind bereits eingesetzt.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760941
    m_Localized: Die Kaserne ist noch nicht gebaut.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760942
    m_Localized: Noch keine Truppen freigeschaltet - Kaserne verbessern.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760943
    m_Localized: "\nDiese gespeicherte Armee ist leer.\nTippe auf \xDCberfall / Halten
      / Belagerung zum schnellen F\xFCllen,\noder [+] Truppen auf der linken Seite.\nDann
      Speichern und Armee trainieren.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760944
    m_Localized: 'Kosten:'
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760945
    m_Localized: 'Warteschlange zum Trainieren: {0} von {1} verwendet, {2} frei.'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760946
    m_Localized: 'Name: {0}'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760947
    m_Localized: Speichern Slot {0}
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760948
    m_Localized: Armee trainieren
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760949
    m_Localized: "Tipp: Trainieren speichert diesen Slot automatisch. F\xFClle die
      Armee, dann \xDCberf\xE4lle."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760950
    m_Localized: "\xDCberfall Starten"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760951
    m_Localized: 'Verteidigungspunkte: {0} / {1}'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760952
    m_Localized: Keine Verteidiger registriert.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760953
    m_Localized: Trupp Rekrutieren
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760954
    m_Localized: Arena-Verteidigung
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760955
    m_Localized: ANGRIFF
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760956
    m_Localized: VERTEIDIGEN
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760957
    m_Localized: MEIN SCHLOSS NUTZEN
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760958
    m_Localized: "Zur\xFCck zur Arena"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760959
    m_Localized: ARENA
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760960
    m_Localized: Kampf!
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760961
    m_Localized: "W\xE4hle eine F\xE4higkeit und dann einen Quick-Swap-Slot."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760962
    m_Localized: "F\xE4higkeiten k\xF6nnen w\xE4hrend des Kampfes nicht ge\xE4ndert
      werden."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760963
    m_Localized: Slot geleert.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760964
    m_Localized: "W\xE4hle erst eine F\xE4higkeit."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760965
    m_Localized: Dem Quick-Swap-Slot {0} zugewiesen.
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760966
    m_Localized: "Diese F\xE4higkeit ist bereits in der Leiste."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760967
    m_Localized: "Zu deiner Quick-Swap-Leiste hinzugef\xFCgt."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760968
    m_Localized: Kein freier Platz (oder bereits in der Leiste).
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760969
    m_Localized: Tippe jetzt auf einen Quick-Swap-Slot.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760970
    m_Localized: "W\xE4hle zuerst eine F\xE4higkeit und tippe dann auf einen Slot."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760971
    m_Localized: Mit Google fortfahren
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760972
    m_Localized: Wallet verbinden
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760973
    m_Localized: "Truppenpl\xE4tze: {0} / {1}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760974
    m_Localized: MEIN SCHLOSS  *
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760975
    m_Localized: MEIN SCHLOSS VERWENDEN
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760976
    m_Localized: Dieser Platz ist bereits leer.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760977
    m_Localized: nichts erschwinglich in diesem Moment
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760978
    m_Localized: '[Lv {0}]'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760979
    m_Localized: PASSIV
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760980
    m_Localized: AKTIV
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760981
    m_Localized: '[ ] '
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760982
    m_Localized: "DIE L\xDCCKE SCHLIESSEN"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760983
    m_Localized: HEUTE GRATIS
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760984
    m_Localized: Es wird nichts verlangt, bevor etwas gegeben wird.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760985
    m_Localized: "K\xF6rbe - alles auf einmal."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760986
    m_Localized: "M\xC4ZENATENTUM"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760987
    m_Localized: Ansehen, niemals Macht.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760988
    m_Localized: "{0}x die {2} des {1}, f\xFCr {3}x den Preis."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760989
    m_Localized: "{0} G\xFCter pro $"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760990
    m_Localized: 'Guthaben danach: {0} SKR'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760991
    m_Localized: Gesperrt
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760992
    m_Localized: "0% GEB\xDCHR - JEDE ZAHLUNG ERREICHT DAS REICH"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760993
    m_Localized: BELOHNUNGSVERTEILER {0}
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760994
    m_Localized: "ZEIT UND SCH\xD6NHEIT, NIEMALS MACHT"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760995
    m_Localized: Du musst niemals etwas ausgeben. Nie.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760996
    m_Localized: Saisonpfad
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760997
    m_Localized: Noch {0} Tage in dieser Saison
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760998
    m_Localized: Stufe {0} von {1}
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760999
    m_Localized: "{0} von {1} XP bis zur n\xE4chsten Stufe"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363761000
    m_Localized: Alle Stufen verdient. {0} XP in dieser Saison.
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363761001
    m_Localized: "Kampf-XP verdienst du durch Spielen. Jeder Arenakampf zahlt, ob
      Sieg oder Niederlage, und eine Siegesserie zahlt mehr. Keine Stufe ist jemals
      k\xE4uflich."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761002
    m_Localized: "Was du verdienst, bleibt dauerhaft dein. Am Saisonende wird nichts
      zur\xFCckgenommen, und alles, was du nicht abgeholt hast, wird dir automatisch
      gegeben."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761003
    m_Localized: GRATIS
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761004
    m_Localized: PREMIUM
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761005
    m_Localized: ABGEHOLT
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761006
    m_Localized: BEREIT
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761007
    m_Localized: GESPERRT
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761008
    m_Localized: PFAD GESPERRT
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761009
    m_Localized: "KR\xD6NUNG"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761010
    m_Localized: Belohnungen abholen
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761011
    m_Localized: Noch nichts abzuholen - spiele einen Arenakampf.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761012
    m_Localized: Premium-Pfad freischalten
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761013
    m_Localized: "Der Premium-Pfad ist in dieser Version nicht k\xE4uflich. Alles
      darauf wird dir dennoch gezeigt - du sollst niemals raten, was hinter einem
      Schloss liegt."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761014
    m_Localized: "Den Pfad sp\xE4ter freizuschalten kostet dich nichts: jede Premium-Belohnung,
      die du bereits erreicht hast, wird sofort \xFCbergeben."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761015
    m_Localized: "Derzeit l\xE4uft keine Saison. Eine neue beginnt am Ersten des
      Monats."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761016
    m_Localized: Monatsregister
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761017
    m_Localized: Noch {0} Abholungen
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363761018
    m_Localized: "Du besitzt kein Register. Alle drei\xDFig Tage werden unten gezeigt,
      bevor du \xFCberhaupt zahlst - es gibt keinen verborgenen und keinen geheimen
      Tag."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761019
    m_Localized: Heute abholen
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761020
    m_Localized: "Abgeholt. Das n\xE4chste geh\xF6rt dir morgen."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761021
    m_Localized: Heutige Abholung
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761022
    m_Localized: "Verpasst du einen Tag, verlierst du nichts. Ein Register h\xE4lt
      drei\xDFig Abholungen und bleibt bestehen, bis jede davon genutzt ist, so lange
      das auch dauert."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761023
    m_Localized: "Hier verf\xE4llt nichts, also l\xE4uft hier auch nichts ab."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761024
    m_Localized: "Das ist ein Bonus zu deiner kostenlosen Tagesbelohnung, niemals
      ein Ersatz daf\xFCr. Eine abzuholen verbraucht nie die andere."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761025
    m_Localized: ABGEHOLT
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761026
    m_Localized: HEUTE
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761027
    m_Localized: DEIN
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761028
    m_Localized: BALD
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761029
    m_Localized: Dieses Register hat noch kein monatsexklusives Andenken. Hier wird
      nichts versprochen, was dir nicht gezeigt werden kann.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761030
    m_Localized: "Register sind in dieser Version nicht k\xE4uflich. Die gesamte
      Tabelle steht trotzdem auf diesem Bildschirm."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761031
    m_Localized: "NICHT K\xC4UFLICH"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761032
    m_Localized: Derzeit sind keine Register angelegt.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761033
    m_Localized: WOCHE {0} | TAGE {1}-{2}
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
