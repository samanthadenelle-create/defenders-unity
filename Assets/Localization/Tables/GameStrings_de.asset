    m_Localized: "Kosmetische Vorteile werden zum Start in SKR bepreist \u2014 vorerst
      nur im Testnet."
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760721
    m_Localized: "Demn\xE4chst \u2014 Testnet-Vorschau. Keine Wallet verbunden."
