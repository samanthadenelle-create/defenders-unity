  - m_Id: 44124330363761147
    m_Localized: '{0} troops lost taking the base.'
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363761148
    m_Localized: The base is CLAIMED - it is yours now.
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363761149
    m_Localized: The base is broken - its stores are yours.
