  - m_Id: 44124330363760783
    m_Localized: "Quelle: {0}. Die Punkte sind lokal; die gezeigten R\xE4nge sind
      Platzhalter-Rivalen, bis die Online-Rangliste verbunden ist."
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760784
    m_Localized: '[ GESPERRT ]'
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760785
    m_Localized: "Erster \xDCberfall gratis - {0}"
    m_Metadata:
      m_Items:
      - rid: 7338888477077143554
  - m_Id: 44124330363760786
    m_Localized: "Erf\xFClle zuerst die Voraussetzung"
    m_Metadata:
      m_Items: []
  - m_Id: 44124330363760787
    m_Localized: "Auftr\xE4ge"
