!/Assets/Resources/Structures/Forge.fbx
!/Assets/Resources/Structures/Forge.fbx.meta
!/Assets/Resources/Structures/Forge.fbm/
!/Assets/Resources/Structures/Forge.fbm.meta
!/Assets/Resources/Structures/Forge.fbm/**
!/Assets/Resources/Structures/Forge.prefab
!/Assets/Resources/Structures/Forge.prefab.meta
!/Assets/Resources/Structures/Forge.mat
!/Assets/Resources/Structures/Forge.mat.meta

