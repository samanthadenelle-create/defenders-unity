# SECRETS -- key.json is an Arweave/permaweb RSA wallet key in JWK form (kty:RSA with the
# private components), generated at the repo root by `npx github:permaweb/wallet` on 2026-08-07.
# It was NEVER committed (verified against --all), but it was sitting unignored where a single
# `git add -A` would have pushed a live wallet private key to GitHub. Ignored defensively here.
# .gitignore is NOT security: a private key does not belong in a source tree at all. Move it to
# somewhere outside the repo and point whatever consumes it at the new path.
key.json
*.jwk
**/arweave-key*.json

# Seeker/adb logcat captures -- multi-MB transient dumps from felt-test sessions.
Logs/*.txt
Logs/*.jsonl

# com.unity.test-framework.performance writes its run metadata into Assets/Resources/,
# which means every player build would BAKE these in and load them at runtime. They are
# regenerated on each test run and hold nothing (MeasurementCount:-1, Results:[]).
# Ignored AND deleted -- ignoring alone still ships them.
Assets/Resources/PerformanceTestRunInfo.json
Assets/Resources/PerformanceTestRunInfo.json.meta
Assets/Resources/PerformanceTestRunSettings.json
Assets/Resources/PerformanceTestRunSettings.json.meta

# Addressables REMOTE bundle output. Build artifact: regenerated by every content build
# and uploaded to Cloudflare R2 by tools/r2_sync.py. Tracking it would commit ~80 MB of
# bundles per build, and the CDN — not git — is where the player fetches them from.
/ServerData/

# Python bytecode - never tracked (slipped in 2026-08-23 via a directory-wide add)
tools/__pycache__/
__pycache__/
*.pyc

.env*

# Synty POLYGON Fantasy Kingdom + POLYGON Generic — 461MB Asset-Store packs kept
# LOCAL (same policy as polyperfect / Quaternius / Blink; owner purchase 2026-09-01,
# WO-1289 art re-theme). Unlike MedievalCastlePackLite these ship URP-native
# (Materials -> PolygonGeneric/Shaders/Generic_Basic.shadergraph, UniversalTarget +
# UniversalLitSubTarget; com.unity.shadergraph is already in Packages/manifest.json)
# so there is NO built-in-Standard magenta pass to run on import.
# On a fresh clone: re-import both packs from the Asset Store into Assets/Synty/.
# Only the specific prefabs/meshes the game references are copied into tracked
# Resources/ + Addressable paths — see WorkOrders/WORK_ORDER_1289_*.md.
/Assets/Synty/
/Assets/Synty.meta
